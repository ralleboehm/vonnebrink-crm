extends ../layouts/main

block content
    .d-flex.justify-content-between.align-items-center.mb-4
        h1.mb-0 Benutzer
        .d-flex.gap-2
            a.btn.btn-outline-secondary(href="/users") Zurück
            a.btn.btn-primary(href=`/users/${user._id}/edit`) Bearbeiten

    .card.shadow-sm
        .card-body
            .row.g-3
                .col-md-6
                    strong Vorname
                    p.mb-0= user.firstName

                .col-md-6
                    strong Nachname
                    p.mb-0= user.lastName

                .col-md-6
                    strong Benutzername
                    p.mb-0= user.username

                .col-md-6
                    strong E-Mail
                    p.mb-0= user.email

                .col-md-6
                    strong Rolle
                    p.mb-0
                        span.badge.bg-secondary= user.role

                .col-md-6
                    strong Status
                    p.mb-0
                        if user.active
                            span.badge.bg-success Aktiv
                        else
                            span.badge.bg-danger Deaktiviert

                .col-md-6
                    strong Letzter Login
                    p.mb-0
                        if user.lastLogin
                            = user.lastLogin.toLocaleString("de-DE")
                        else
                            | Noch kein Login

                .col-md-6
                    strong Angelegt am
                    p.mb-0= user.createdAt.toLocaleString("de-DE")

            if user.active
                hr
                form(method="POST" action=`/users/${user._id}/deactivate`)
                    button.btn.btn-outline-danger(
                        type="submit"
                        onclick="return confirm('Diesen Benutzer wirklich deaktivieren?')"
                    ) Benutzer deaktivieren