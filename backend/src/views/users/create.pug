extends ../layouts/main

block content
    .d-flex.justify-content-between.align-items-center.mb-4
        h1.mb-0 Neuer Benutzer
        a.btn.btn-outline-secondary(href="/users") Zurück

    .card.shadow-sm
        .card-body
            form(method="POST" action="/users")
                .row.g-3
                    .col-md-6
                        label.form-label(for="firstName") Vorname
                        input.form-control(
                            type="text"
                            id="firstName"
                            name="firstName"
                            required
                            maxlength="100"
                        )

                    .col-md-6
                        label.form-label(for="lastName") Nachname
                        input.form-control(
                            type="text"
                            id="lastName"
                            name="lastName"
                            required
                            maxlength="100"
                        )

                    .col-md-6
                        label.form-label(for="username") Benutzername
                        input.form-control(
                            type="text"
                            id="username"
                            name="username"
                            required
                            minlength="3"
                            maxlength="50"
                        )

                    .col-md-6
                        label.form-label(for="email") E-Mail
                        input.form-control(
                            type="email"
                            id="email"
                            name="email"
                            required
                            maxlength="255"
                        )

                    .col-md-6
                        label.form-label(for="password") Passwort
                        input.form-control(
                            type="password"
                            id="password"
                            name="password"
                            required
                        )

                    .col-md-6
                        label.form-label(for="role") Rolle
                        select.form-select(
                            id="role"
                            name="role"
                            required
                        )
                            option(value="technician") Techniker
                            option(value="sales") Vertrieb
                            option(value="admin") Administrator

                .mt-4
                    button.btn.btn-primary(type="submit") Benutzer anlegen
                    a.btn.btn-outline-secondary.ms-2(href="/users") Abbrechen