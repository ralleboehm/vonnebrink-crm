extends ../layouts/main

block content
    .d-flex.justify-content-between.align-items-center.mb-4
        h1.mb-0 Benutzer
        a.btn.btn-primary(href="/users/new") Neuer Benutzer

    .card.shadow-sm
        .card-body.p-0
            if users.length
                .table-responsive
                    table.table.table-hover.mb-0
                        thead.table-light
                            tr
                                th Name
                                th Benutzername
                                th E-Mail
                                th Rolle
                                th Status
                                th.text-end Aktionen
                        tbody
                            each user in users
                                tr
                                    td
                                        a.text-decoration-none(href=`/users/${user._id}`)
                                            | #{user.firstName} #{user.lastName}
                                    td= user.username
                                    td= user.email
                                    td
                                        span.badge.bg-secondary= user.role
                                    td
                                        if user.active
                                            span.badge.bg-success Aktiv
                                        else
                                            span.badge.bg-danger Deaktiviert
                                    td.text-end
                                        a.btn.btn-sm.btn-outline-primary(href=`/users/${user._id}`)
                                            | Anzeigen
                                        | 
                                        a.btn.btn-sm.btn-outline-secondary(href=`/users/${user._id}/edit`)
                                            | Bearbeiten
            else
                .p-4.text-center.text-muted
                    | Noch keine Benutzer vorhanden.