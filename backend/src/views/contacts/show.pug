extends ../layouts/main

block content

    .d-flex.justify-content-between.align-items-center.mb-4

        h1.mb-0 #{contact.firstName} #{contact.lastName}

        div
            a.btn.btn-outline-secondary.me-2(
                href=`/contacts/${contact._id}/edit`
            ) Bearbeiten

            a.btn.btn-secondary(
                href=`/companies/${contact.company._id}`
            ) Zurück zur Firma

    .card.shadow-sm

        .card-header
            h5.mb-0 Kontaktdaten

        .card-body

            .row

                .col-md-6

                    p
                        strong Kontaktnummer:
                        br
                        = contact.contactNumber

                    p
                        strong Firma:
                        br
                        a(href=`/companies/${contact.company._id}`)
                            = contact.company.companyName

                    p
                        strong Anrede:
                        br
                        case contact.salutation
                            when "mr"
                                | Herr
                            when "mrs"
                                | Frau
                            when "diverse"
                                | Divers
                            default
                                | -

                    p
                        strong Position:
                        br
                        = contact.position || "-"

                .col-md-6

                    p
                        strong Telefon:
                        br
                        = contact.phone || "-"

                    p
                        strong Mobil:
                        br
                        = contact.mobile || "-"

                    p
                        strong E-Mail:
                        br
                        = contact.email || "-"

                    p
                        strong Status:
                        br
                        case contact.status
                            when "active"
                                span.badge.bg-success Aktiv
                            when "inactive"
                                span.badge.bg-secondary Inaktiv
                            default
                                span.badge.bg-light.text-dark Unbekannt

            if contact.notes

                hr

                h5 Notizen

                p= contact.notes