extends ../layouts/main

block content

    .d-flex.justify-content-between.align-items-center.mb-4

        h1.mb-0 Kontakte

        a.btn.btn-primary(href="/contacts/new")
            | ➕ Neuer Kontakt

    if contacts.length

        .card.shadow-sm

            .card-body.p-0

                table.table.table-hover.table-striped.mb-0

                    thead.table-dark

                        tr
                            th Kontaktnummer
                            th Name
                            th Firma
                            th Position
                            th Telefon
                            th E-Mail
                            th Status
                            th.text-end Aktionen

                    tbody

                        each contact in contacts

                            tr

                                td= contact.contactNumber

                                td
                                    a.text-decoration-none(href=`/contacts/${contact._id}`)
                                        strong #{contact.firstName} #{contact.lastName}

                                td
                                    if contact.company
                                        a.text-decoration-none(href=`/companies/${contact.company._id}`)
                                            = contact.company.companyName
                                    else
                                        | -

                                td= contact.position

                                td= contact.phone

                                td= contact.email

                                td
                                    case contact.status
                                        when "active"
                                            span.badge.bg-success Aktiv
                                        when "inactive"
                                            span.badge.bg-secondary Inaktiv
                                        default
                                            span.badge.bg-light.text-dark Unbekannt

                                td.text-end

                                    a.btn.btn-sm.btn-outline-primary.me-1(
                                        href=`/contacts/${contact._id}`
                                    ) Anzeigen

                                    a.btn.btn-sm.btn-outline-secondary.me-1(
                                        href=`/contacts/${contact._id}/edit`
                                    ) Bearbeiten

                                    form(
                                        action=`/contacts/${contact._id}/delete`
                                        method="POST"
                                        style="display:inline;"
                                        onsubmit="return confirm('Kontakt wirklich löschen?');"
                                    )
                                        button.btn.btn-sm.btn-outline-danger(type="submit")
                                            | Löschen

    else

        .alert.alert-info

            | Es sind noch keine Kontakte vorhanden.