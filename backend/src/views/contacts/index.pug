extends ../layouts/main

block content

    h1 Kontakte

    p
        a(href="/contacts/new") ➕ Neuer Kontakt

    if contacts.length

        table
            thead
                tr
                    th Kontaktnummer
                    th Name
                    th Firma
                    th Position
                    th Telefon
                    th E-Mail
                    th Status
                    th Aktionen

            tbody
                each contact in contacts
                    tr

                        td= contact.contactNumber

                        td
                            a(href=`/contacts/${contact._id}`)
                                = `${contact.firstName} ${contact.lastName}`

                        td
                            if contact.company
                                = contact.company.companyName
                            else
                                | -

                        td= contact.position

                        td= contact.phone

                        td= contact.email

                        td
                            case contact.status
                                when "active"
                                    | Aktiv
                                when "inactive"
                                    | Inaktiv
                                default
                                    | Unbekannt

                        td
                            a(href=`/contacts/${contact._id}`) Anzeigen
                            |  |
                            a(href=`/contacts/${contact._id}/edit`) Bearbeiten
                            |  |

                            form(
                                action=`/contacts/${contact._id}/delete`
                                method="POST"
                                style="display:inline;"
                                onsubmit="return confirm('Kontakt wirklich löschen?');"
                            )
                                button(type="submit") Löschen

    else

        p Es sind noch keine Kontakte vorhanden.