extends ../crm/layouts/guest

block content

    .vb-guest-panel(style="max-width: 520px; width: 100%;")

        .p-4.p-md-5.text-center

            img.mb-4(src="/images/logo-wordmark.png" alt="Vonnebrink IT Operations" style="height: 32px;")

            h1.h4.mb-3(class=`text-${tone || "primary"}`)= heading

            p.text-muted.mb-4= text

            if action

                form(method="POST" action=action)

                    button.btn.btn-primary(type="submit")= button
