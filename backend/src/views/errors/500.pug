extends ../crm/layouts/guest

block content

    .vb-guest-panel.text-center.p-4.p-md-5(style="max-width: 520px; width: 100%;")

        img.mb-4(src="/images/logo-wordmark.png" alt="Vonnebrink IT Operations" style="height: 30px;")

        .display-4.fw-bold.text-muted 500

        h1.h4.mb-3 Serverfehler

        p.text-muted.mb-4
            | Es ist ein unerwarteter Fehler aufgetreten.

        if message
            p.small.text-muted= message

        a.btn.btn-primary(href=homeUrl || "/crm")
            | Zurück zur Startseite
