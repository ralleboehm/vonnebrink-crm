extends ../layouts/main

block content

    h1 Firmen

    p
        a(href="/companies/new") ➕ Neue Firma

    if companies.length

        table
            thead
                tr
                    th Kundennummer
                    th Firma
                    th Status
                    th Telefon
                    th E-Mail
                    th Aktionen

            tbody
                each company in companies
                    tr

                        td= company.customerNumber

                        td
                            a(href=`/companies/${company._id}`)
                                = company.companyName

                        td
                            case company.status
                                when "prospect"
                                    | Interessent
                                when "customer"
                                    | Kunde
                                when "inactive"
                                    | Inaktiv
                                default
                                    | Unbekannt

                        td= company.phone

                        td= company.email

                        td
                            a(href=`/companies/${company._id}`) Anzeigen
                            |  |
                            a(href=`/companies/${company._id}/edit`) Bearbeiten
                            |  |

                            form(
                                action=`/companies/${company._id}/delete`
                                method="POST"
                                style="display:inline;"
                                onsubmit="return confirm('Firma wirklich löschen?');"
                            )
                                button(type="submit") Löschen

    else

        p Es sind noch keine Firmen vorhanden.