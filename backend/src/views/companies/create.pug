extends ../layouts/main

block content

    h1 Neue Firma

    form(method="POST" action="/companies")

        div
            label(for="companyName") Firmenname
            br
            input(
                type="text"
                id="companyName"
                name="companyName"
                required
                autofocus
            )

        br

        div
            label(for="status") Status
            br
            select(
                id="status"
                name="status"
            )
                option(value="prospect" selected) Interessent
                option(value="customer") Kunde
                option(value="inactive") Inaktiv

        br

        div
            label(for="phone") Telefon
            br
            input(
                type="text"
                id="phone"
                name="phone"
            )

        br

        div
            label(for="email") E-Mail
            br
            input(
                type="email"
                id="email"
                name="email"
            )

        br

        div
            label(for="website") Webseite
            br
            input(
                type="url"
                id="website"
                name="website"
            )

        br

        button(type="submit") 💾 Firma anlegen
        |  
        a(href="/companies") Abbrechen