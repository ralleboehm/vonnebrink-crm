extends ../layouts/main

block content

    .d-flex.justify-content-between.align-items-center.mb-4

        h1.mb-0= company.companyName

        div
            a.btn.btn-outline-secondary.me-2(
                href=`/companies/${company._id}/edit`
            ) Bearbeiten

            a.btn.btn-secondary(
                href="/companies"
            ) Zurück

    .card.shadow-sm.mb-4

        .card-header
            h5.mb-0 Firmendaten

        .card-body

            .row

                .col-md-6

                    p
                        strong Kundennummer:
                        br
                        = company.customerNumber

                    p
                        strong Status:
                        br
                        case company.status
                            when "prospect"
                                span.badge.bg-warning.text-dark Interessent
                            when "customer"
                                span.badge.bg-success Kunde
                            when "inactive"
                                span.badge.bg-secondary Inaktiv
                            default
                                span.badge.bg-light.text-dark Unbekannt

                    p
                        strong Telefon:
                        br
                        = company.phone || "-"

                    p
                        strong E-Mail:
                        br
                        = company.email || "-"

                    p
                        strong Webseite:
                        br
                        if company.website
                            a(href=company.website target="_blank")
                                = company.website
                        else
                            | -

                .col-md-6

                    p
                        strong Adresse:
                        br

                        if company.address

                            if company.address.street
                                | #{company.address.street}
                                br

                            if company.address.postalCode || company.address.city
                                | #{company.address.postalCode} #{company.address.city}
                                br

                            if company.address.country
                                | #{company.address.country}

                        else
                            | -

    .d-flex.justify-content-between.align-items-center.mb-3

        h3.mb-0 Ansprechpartner

        a.btn.btn-primary(
            href=`/contacts/new?company=${company._id}`
        ) ➕ Neuer Ansprechpartner

    if contacts.length

        .card.shadow-sm

            .card-body.p-0

                table.table.table-hover.mb-0

                    thead.table-dark

                        tr
                            th Kontaktnummer
                            th Name
                            th Position
                            th Telefon
                            th E-Mail
                            th.text-end Aktionen

                    tbody

                        each contact in contacts

                            tr

                                td= contact.contactNumber

                                td
                                    a.text-decoration-none(
                                        href=`/contacts/${contact._id}`
                                    )
                                        strong #{contact.firstName} #{contact.lastName}

                                td= contact.position

                                td= contact.phone

                                td= contact.email

                                td.text-end

                                    a.btn.btn-sm.btn-outline-primary.me-1(
                                        href=`/contacts/${contact._id}`
                                    ) Anzeigen

                                    a.btn.btn-sm.btn-outline-secondary(
                                        href=`/contacts/${contact._id}/edit`
                                    ) Bearbeiten

    else

        .alert.alert-info

            | Für diese Firma sind noch keine Ansprechpartner vorhanden.