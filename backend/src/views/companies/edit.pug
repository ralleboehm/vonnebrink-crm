extends ../layouts/main

block content

    h1 Firma bearbeiten

    form(method="POST" action=`/companies/${company._id}/update`)

        div
            label(for="companyName") Firmenname
            br
            input(
                type="text"
                id="companyName"
                name="companyName"
                value=company.companyName
                required
                autofocus
            )

        br

        div
            label(for="status") Status
            br
            select(
                id="status"
                name="status"
            )
                option(
                    value="prospect"
                    selected=company.status === "prospect"
                ) Interessent

                option(
                    value="customer"
                    selected=company.status === "customer"
                ) Kunde

                option(
                    value="inactive"
                    selected=company.status === "inactive"
                ) Inaktiv

        br

        div
            label(for="phone") Telefon
            br
            input(
                type="text"
                id="phone"
                name="phone"
                value=company.phone
            )

        br

        div
            label(for="email") E-Mail
            br
            input(
                type="email"
                id="email"
                name="email"
                value=company.email
            )

        br

        div
            label(for="website") Webseite
            br
            input(
                type="url"
                id="website"
                name="website"
                value=company.website
            )

        br

        button(type="submit") 💾 Änderungen speichern
        |  
        a(href="/companies") Abbrechen