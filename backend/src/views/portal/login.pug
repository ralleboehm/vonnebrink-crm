extends layouts/main

block content

    .vb-login

        .row.g-0

            // =====================================================
            // Links: Marke und Nutzen (wie vonnebrink.com)
            // =====================================================

            .col-lg-6.vb-login-aside

                img.vb-logo(src="/images/logo-wordmark-light.png" alt="Vonnebrink IT Operations" style="height: 30px;")

                h2
                    | Ihre IT.
                    br
                    span Sicher. Betreut.

                ul.vb-checks

                    li
                        i.bi.bi-check-circle-fill
                        span Persönlicher IT-Ansprechpartner aus Lampertheim

                    li
                        i.bi.bi-check-circle-fill
                        span Ihre Tickets und deren Stand jederzeit im Blick

                    li
                        i.bi.bi-check-circle-fill
                        span Antworten und Dateien direkt hier im Portal

            // =====================================================
            // Rechts: Anmeldung
            // =====================================================

            .col-lg-6.vb-login-form

                .vb-eyebrow Kundenportal

                h1.mt-1.mb-2 Anmelden

                p.text-muted.mb-4 Mit Ihrer E-Mail-Adresse und Ihrem Passwort.

                if error

                    .alert.alert-danger(role="alert")

                        i.bi.bi-exclamation-triangle.me-2

                        = error

                form(method="POST" action="/portal/login")

                    .mb-3

                        label.form-label(for="email") E-Mail-Adresse

                        input.form-control(
                            type="email"
                            id="email"
                            name="email"
                            value=(typeof email !== "undefined" ? email : "")
                            required
                            autocomplete="username"
                            autofocus
                        )

                    .mb-4

                        label.form-label(for="password") Passwort

                        input.form-control(
                            type="password"
                            id="password"
                            name="password"
                            required
                            autocomplete="current-password"
                        )

                    button.btn.btn-primary.btn-lg.w-100(type="submit")

                        | Anmelden

                        i.bi.bi-arrow-right.ms-2

                p.small.text-muted.mt-4.mb-0

                    | Noch keinen Zugang oder Passwort vergessen? Sprechen Sie uns an –
                    |
                    a(href="https://vonnebrink.com/contact-2/" rel="noopener") Kontakt
                    | .
