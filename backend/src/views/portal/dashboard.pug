extends layouts/main

include partials/_status

block content

    - const user = currentPortalUser || {}
    - const active = tickets.filter((t) => ["open", "in_progress", "waiting"].includes(t.status))
    - const inProgress = tickets.filter((t) => t.status === "in_progress")
    - const done = tickets.filter((t) => ["resolved", "closed"].includes(t.status))
    - const recent = tickets.slice().sort((a, b) => new Date(b.updatedAt || b.createdAt) - new Date(a.updatedAt || a.createdAt)).slice(0, 5)
    - const formatDate = (date) => date ? new Date(date).toLocaleDateString("de-DE", { timeZone: "Europe/Berlin" }) : "—"

    // =====================================================
    // Begrüßung
    // =====================================================

    section.vb-hero

        .vb-eyebrow= user.companyName || "Kundenportal"

        h1 Guten Tag, #{user.firstName} #{user.lastName}

        p.mb-4(style="max-width: 560px;")

            if active.length

                | Sie haben #{active.length} #{active.length === 1 ? "offenes Ticket" : "offene Tickets"}. Wir kümmern uns darum und halten Sie hier auf dem Laufenden.

            else

                | Alles erledigt – Sie haben keine offenen Tickets. Brauchen Sie Hilfe? Schreiben Sie uns einfach ein Ticket.

        .d-flex.flex-wrap.gap-2

            a.btn.btn-primary(href="/portal/tickets/new")

                i.bi.bi-plus-lg.me-2

                | Neues Ticket

            a.btn.btn-light-outline(href="/portal/tickets")

                | Alle Tickets

    // =====================================================
    // Kennzahlen
    // =====================================================

    .row.g-3.mb-4

        .col-md-4

            .card.h-100

                a.vb-stat(href="/portal/tickets")

                    span.vb-stat-icon

                        i.bi.bi-inbox

                    div

                        .vb-stat-value= active.length

                        .vb-stat-label Offen

        .col-md-4

            .card.h-100

                a.vb-stat(href="/portal/tickets")

                    span.vb-stat-icon.is-amber

                        i.bi.bi-tools

                    div

                        .vb-stat-value= inProgress.length

                        .vb-stat-label In Bearbeitung

        .col-md-4

            .card.h-100

                a.vb-stat(href="/portal/tickets")

                    span.vb-stat-icon.is-teal

                        i.bi.bi-check2-circle

                    div

                        .vb-stat-value= done.length

                        .vb-stat-label Erledigt

    .row.g-4

        // =====================================================
        // Letzte Tickets
        // =====================================================

        .col-lg-8

            .card

                .card-header.d-flex.justify-content-between.align-items-center

                    h5 Zuletzt aktualisiert

                    if tickets.length > recent.length

                        a.small.fw-semibold(href="/portal/tickets") Alle #{tickets.length} anzeigen

                if recent.length

                    .table-responsive

                        table.table.table-hover.align-middle

                            thead

                                tr

                                    th Ticket

                                    th Betreff

                                    th Status

                                    th.text-end Aktualisiert

                            tbody

                                each ticket in recent

                                    tr

                                        td.text-nowrap

                                            a.fw-semibold.text-decoration-none(href=`/portal/tickets/${ticket._id}`)= ticket.ticketNumber

                                        td

                                            a.text-reset.text-decoration-none(href=`/portal/tickets/${ticket._id}`)= ticket.subject

                                        td

                                            +ticketStatus(ticket.status)

                                        td.text-end.text-muted.small.text-nowrap= formatDate(ticket.updatedAt || ticket.createdAt)

                else

                    .card-body.text-center.py-5

                        i.bi.bi-ticket-perforated.display-6.text-muted

                        p.text-muted.mt-3.mb-3 Noch keine Tickets vorhanden.

                        a.btn.btn-primary(href="/portal/tickets/new")

                            i.bi.bi-plus-lg.me-2

                            | Erstes Ticket erstellen

        // =====================================================
        // Hilfe
        // =====================================================

        .col-lg-4

            .card.h-100

                .card-header

                    h5 So helfen wir Ihnen am schnellsten

                .card-body

                    ul.vb-help.list-unstyled.mb-4

                        li

                            i.bi.bi-1-circle-fill

                            span Beschreiben Sie das Problem kurz und genau – was passiert, seit wann, an welchem Gerät.

                        li

                            i.bi.bi-2-circle-fill

                            span Hängen Sie Screenshots oder Fehlermeldungen als Datei an.

                        li

                            i.bi.bi-3-circle-fill

                            span Unsere Antworten und den aktuellen Stand finden Sie jederzeit hier im Ticket.

                    a.btn.btn-outline-primary.w-100(href="https://vonnebrink.com/contact-2/" rel="noopener")

                        i.bi.bi-telephone.me-2

                        | Kontakt bei dringenden Störungen
