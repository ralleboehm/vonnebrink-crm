extends ../layouts/main

include ../partials/_status

block content

    .d-flex.justify-content-between.align-items-center.mb-4

        h1.mb-0

            i.bi.bi-ticket-perforated.me-2

            | Ticket #{ticket.ticketNumber}

        a.btn.btn-secondary(href="/portal/tickets")

            i.bi.bi-arrow-left.me-2

            | Zurück

    // =====================================================
    // Ticketinformationen
    // =====================================================

    .card.shadow-sm.mb-4

        .card-header

            h5.mb-0 Ticketinformationen

        .card-body

            .row

                .col-md-6.mb-3

                    strong Betreff

                    p.mb-0= ticket.subject

                .col-md-3.mb-3

                    strong Status

                    p.mb-0

                        +ticketStatus(ticket.status)

                .col-md-3.mb-3

                    strong Priorität

                    p.mb-0

                        +ticketPriority(ticket.priority)

            .row

                .col-md-6.mb-3

                    strong Firma

                    p.mb-0= ticket.company.companyName

                .col-md-6.mb-3

                    strong Ansprechpartner

                    if ticket.contact
                        p.mb-0 #{ticket.contact.firstName} #{ticket.contact.lastName}
                    else
                        p.mb-0.text-muted -

            .row

                .col-md-6.mb-3

                    strong Erstellt am

                    p.mb-0= ticket.createdAt.toLocaleString("de-DE")

                .col-md-6.mb-3

                    strong Fällig

                    if ticket.dueDate
                        p.mb-0= ticket.dueDate.toLocaleDateString("de-DE")
                    else
                        p.mb-0.text-muted Keine Frist

    // =====================================================
    // Beschreibung
    // =====================================================

    .card.shadow-sm.mb-4

        .card-header

            h5.mb-0 Beschreibung

        .card-body

            p.mb-0(style="white-space: pre-wrap;")= ticket.description

    // =====================================================
    // Nachrichten
    // =====================================================

    .card.shadow-sm.mb-4

        .card-header

            h5.mb-0 Kommunikation

        .card-body

            if messages && messages.length

                each message in messages

                    .border.rounded.p-3.mb-3

                        .d-flex.justify-content-between.align-items-center.mb-2

                            if message.author
                                strong #{message.author.firstName} #{message.author.lastName}
                            else
                                strong Unbekannter Benutzer

                            small.text-muted= message.createdAt.toLocaleString("de-DE")

                        p.mb-0(style="white-space: pre-wrap;")= message.message

            else

                p.text-muted.mb-0

                    | Es wurden bisher keine Nachrichten geschrieben.

    // =====================================================
    // Antwort schreiben
    // =====================================================

    .card.shadow-sm.mb-4

        .card-header

            h5.mb-0 Antwort schreiben

        .card-body

            form(
                method="POST"
                action=`/portal/tickets/${ticket._id}/messages`
            )

                .mb-3

                    textarea.form-control(
                        name="message"
                        rows="6"
                        maxlength="10000"
                        required
                    )

                button.btn.btn-primary(type="submit")

                    i.bi.bi-send.me-2

                    | Antwort senden

    // =====================================================
    // Dateianhänge
    // =====================================================

    .card.shadow-sm.mb-4

        .card-header

            h5.mb-0

                i.bi.bi-paperclip.me-2

                | Dateianhänge

        .card-body

            form(
                method="POST"
                action=`/portal/tickets/${ticket._id}/attachments`
                enctype="multipart/form-data"
            )

                .mb-3

                    input.form-control(
                        type="file"
                        name="attachment"
                        required
                    )

                .d-flex.justify-content-end.mb-4

                    button.btn.btn-primary(type="submit")

                        i.bi.bi-upload.me-2

                        | Datei hochladen

            hr.mb-4

            if attachments && attachments.length

                each attachment in attachments

                    .border.rounded.bg-light.p-3.mb-3

                        .d-flex.justify-content-between.align-items-center

                            div

                                h6.mb-1

                                    i.bi.bi-paperclip.me-2

                                    = attachment.originalName

                                small.text-muted

                                    if attachment.uploadedBy

                                        | Hochgeladen von #{attachment.uploadedBy.firstName} #{attachment.uploadedBy.lastName}

                                    else

                                        | Unbekannter Benutzer

                                    |  • #{attachment.createdAt.toLocaleString("de-DE")}

                                br

                                small.text-muted

                                    = formatFileSize(attachment.size)

                            a.btn.btn-outline-primary.btn-sm(
                                href=`/portal/tickets/${ticket._id}/attachments/${attachment._id}`
                            )

                                i.bi.bi-download.me-1

                                | Download

            else

                .text-center.py-4

                    i.bi.bi-paperclip.display-5.text-muted

                    p.text-muted.mt-3.mb-0

                        | Für dieses Ticket wurden noch keine Dateien hochgeladen.