extends ../layouts/main

block content

    .d-flex.justify-content-between.align-items-center.mb-4

        h1.mb-0

            i.bi.bi-ticket-perforated.me-2

            | Ticket #{ticket.ticketNumber}

        a.btn.btn-secondary(href="/portal/tickets")

            i.bi.bi-arrow-left.me-2

            | Zurück

    // Ticketinformationen

    .card.shadow-sm.mb-4

        .card-header

            h5.mb-0 Ticketinformationen

        .card-body

            .row

                .col-md-6.mb-3

                    strong Betreff

                    p.mb-0= ticket.subject

                .col-md-3.mb-3

                    strong Status

                    p.mb-0

                        case ticket.status

                            when "open"
                                span.badge.bg-primary Offen

                            when "in_progress"
                                span.badge.bg-warning.text-dark In Bearbeitung

                            when "waiting"
                                span.badge.bg-secondary Wartend

                            when "resolved"
                                span.badge.bg-success Gelöst

                            when "closed"
                                span.badge.bg-dark Geschlossen

                            default
                                span.badge.bg-secondary= ticket.status

                .col-md-3.mb-3

                    strong Priorität

                    p.mb-0

                        case ticket.priority

                            when "low"
                                span.badge.bg-success Niedrig

                            when "normal"
                                span.badge.bg-primary Normal

                            when "high"
                                span.badge.bg-warning.text-dark Hoch

                            when "urgent"
                                span.badge.bg-danger Dringend

                            default
                                span.badge.bg-secondary= ticket.priority

            .row

                .col-md-6.mb-3

                    strong Firma

                    p.mb-0= ticket.company.companyName

                .col-md-6.mb-3

                    strong Ansprechpartner

                    if ticket.contact
                        p.mb-0 #{ticket.contact.firstName} #{ticket.contact.lastName}
                    else
                        p.mb-0.text-muted -

            .row

                .col-md-6.mb-3

                    strong Erstellt am

                    p.mb-0= ticket.createdAt.toLocaleString("de-DE")

                .col-md-6.mb-3

                    strong Fällig

                    if ticket.dueDate
                        p.mb-0= ticket.dueDate.toLocaleDateString("de-DE")
                    else
                        p.mb-0.text-muted Keine Frist

    // Beschreibung

    .card.shadow-sm.mb-4

        .card-header

            h5.mb-0 Beschreibung

        .card-body

            p.mb-0(style="white-space: pre-wrap;")= ticket.description

    // Nachrichten

    .card.shadow-sm.mb-4

        .card-header

            h5.mb-0 Kommunikation

        .card-body

            if messages.length

                each message in messages

                    .border.rounded.p-3.mb-3

                        .d-flex.justify-content-between.align-items-center.mb-2

                            strong #{message.author.firstName} #{message.author.lastName}

                            small.text-muted= message.createdAt.toLocaleString("de-DE")

                        p.mb-0(style="white-space: pre-wrap;")= message.message

            else

                p.text-muted.mb-0

                    | Es wurden bisher keine Nachrichten geschrieben.

    // Antwort schreiben

    .card.shadow-sm

        .card-header

            h5.mb-0 Antwort schreiben

        .card-body

            form(
                method="POST"
                action=`/portal/tickets/${ticket._id}/reply`
            )

                .mb-3

                    textarea.form-control(
                        name="message"
                        rows="6"
                        required
                    )

                button.btn.btn-primary(type="submit")

                    i.bi.bi-send.me-2

                    | Antwort senden