extends ../layouts/main

include ../partials/_status

block content

    .d-flex.justify-content-between.align-items-center.mb-4

        h1.mb-0

            i.bi.bi-ticket-perforated.me-2

            | Meine Tickets

        a.btn.btn-primary(
            href="/portal/tickets/new"
        )

            i.bi.bi-plus-circle.me-2

            | Neues Ticket

    if tickets.length

        .card.shadow-sm

            .card-body.p-0

                table.table.table-hover.mb-0

                    thead

                        tr

                            th Ticket

                            th Betreff

                            th Status

                            th Priorität

                            th Erstellt

                            th.text-end Aktion

                    tbody

                        each ticket in tickets

                            tr

                                td

                                    strong= ticket.ticketNumber

                                td= ticket.subject

                                td

                                    +ticketStatus(ticket.status)

                                td

                                    +ticketPriority(ticket.priority)

                                td= ticket.createdAt.toLocaleDateString("de-DE")

                                td.text-end

                                    a.btn.btn-sm.btn-outline-primary(
                                        href=`/portal/tickets/${ticket._id}`
                                    )

                                        i.bi.bi-eye.me-1

                                        | Öffnen

    else

        .card.shadow-sm

            .card-body.text-center.py-5

                i.bi.bi-ticket-perforated.display-4.text-muted

                h4.mt-3

                    | Noch keine Tickets vorhanden

                p.text-muted.mb-4

                    | Sie haben bisher keine Support-Tickets erstellt.

                a.btn.btn-primary(
                    href="/portal/tickets/new"
                )

                    i.bi.bi-plus-circle.me-2

                    | Erstes Ticket erstellen