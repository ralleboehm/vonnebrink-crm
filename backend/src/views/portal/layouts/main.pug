doctype html

html(lang="de")

    head

        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1")

        title #{title ? title + " – " : ""}Vonnebrink Kundenportal

        link(rel="icon" type="image/png" href="/images/logo-mark.png")

        // Bootstrap
        link(
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
            rel="stylesheet"
        )

        // Bootstrap Icons
        link(
            href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"
            rel="stylesheet"
        )

        // Schriften wie auf vonnebrink.com
        link(rel="preconnect" href="https://fonts.googleapis.com")
        link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)

        link(
            href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@700&family=Montserrat:wght@600;700&family=Source+Sans+3:wght@400;600;700&display=swap"
            rel="stylesheet"
        )

        // Portal-Design (Farben und Schriften der Webseite)
        link(
            rel="stylesheet"
            href="/css/portal.css"
        )

    - const path = typeof currentPath !== "undefined" ? currentPath : ""
    - const isActive = (target) => target === "/portal" ? path === "/portal" || path === "/portal/" : path === target || (target === "/portal/tickets" && path.startsWith("/portal/tickets/") && path !== "/portal/tickets/new")

    body.vb-portal

        header.vb-header

            .vb-brandbar

            nav.navbar.navbar-expand-lg

                .container

                    a.navbar-brand.d-flex.align-items-center.me-4(href="/portal")

                        img.vb-logo(
                            src="/images/logo-wordmark.png"
                            alt="Vonnebrink IT Operations"
                        )

                        span.vb-brand-label Kundenportal

                    if currentPortalUser

                        button.navbar-toggler(
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#navbarPortal"
                            aria-controls="navbarPortal"
                            aria-expanded="false"
                            aria-label="Navigation umschalten"
                        )

                            span.navbar-toggler-icon

                        .collapse.navbar-collapse#navbarPortal

                            ul.navbar-nav.me-auto

                                li.nav-item

                                    a.nav-link(href="/portal" class=isActive("/portal") ? "active" : "")

                                        | Übersicht

                                li.nav-item

                                    a.nav-link(href="/portal/tickets" class=isActive("/portal/tickets") ? "active" : "")

                                        | Meine Tickets

                                li.nav-item

                                    a.nav-link(href="/portal/tickets/new" class=isActive("/portal/tickets/new") ? "active" : "")

                                        | Neues Ticket

                            ul.navbar-nav.ms-auto

                                li.nav-item.dropdown

                                    a.nav-link.dropdown-toggle.vb-user(
                                        href="#"
                                        role="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false"
                                    )

                                        span.vb-avatar= String(currentPortalUser.firstName || "").charAt(0) + String(currentPortalUser.lastName || "").charAt(0)

                                        span.d-lg-none.d-xl-inline #{currentPortalUser.firstName} #{currentPortalUser.lastName}

                                    ul.dropdown-menu.dropdown-menu-end

                                        li

                                            h6.dropdown-header.mb-0

                                                = currentPortalUser.firstName + " " + currentPortalUser.lastName

                                            small.dropdown-item-text.text-muted

                                                = currentPortalUser.companyName

                                        li

                                            hr.dropdown-divider

                                        li

                                            a.dropdown-item(href="/portal/profile")

                                                i.bi.bi-person.me-2

                                                | Mein Profil

                                        li

                                            a.dropdown-item(href="/portal/profile/password")

                                                i.bi.bi-key.me-2

                                                | Passwort ändern

                                        li

                                            hr.dropdown-divider

                                        li

                                            a.dropdown-item.text-danger(href="/portal/logout")

                                                i.bi.bi-box-arrow-right.me-2

                                                | Abmelden

                    else

                        a.btn.btn-outline-primary.btn-sm.ms-auto.d-none.d-sm-inline-block(href="https://vonnebrink.com" rel="noopener")

                            | Zur Webseite

        main.container.py-5

            block content

        footer.vb-footer

            .container

                .row.g-4.align-items-center

                    .col-md-4

                        img.vb-logo(src="/images/logo-wordmark-light.png" alt="Vonnebrink IT Operations")

                        .small.mt-2 IT-Betrieb, der schützt.

                    .col-md-5

                        nav.d-flex.flex-wrap.gap-3(aria-label="Links zur Webseite")

                            a(href="https://vonnebrink.com" rel="noopener") vonnebrink.com
                            a(href="https://vonnebrink.com/services/" rel="noopener") Dienstleistungen
                            a(href="https://vonnebrink.com/contact-2/" rel="noopener") Kontakt
                            a(href="https://vonnebrink.com/impressum/" rel="noopener") Impressum

                    .col-md-3.text-md-end.small

                        | © #{new Date().getFullYear()} Vonnebrink IT Operations

        script(
            src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        )

        block scripts
