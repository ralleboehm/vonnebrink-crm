extends ../layouts/main

block content

    .d-flex.justify-content-between.align-items-center.mb-4

        h1.mb-0 Mein Profil

        a.btn.btn-secondary(
            href="/portal"
        )

            i.bi.bi-arrow-left.me-2

            | Dashboard

    if flash

        .alert(class=`alert-${flash.type}`)= flash.text

    .card.shadow-sm

        .card-header

            h5.mb-0

                i.bi.bi-person.me-2

                | Persönliche Daten

        .card-body

            form(method="POST" action="/portal/profile")

                .row

                    .col-md-6.mb-3

                        label.form-label(for="firstName")

                            | Vorname

                        input.form-control(
                            type="text"
                            id="firstName"
                            name="firstName"
                            value=contact.firstName
                            required
                        )

                    .col-md-6.mb-3

                        label.form-label(for="lastName")

                            | Nachname

                        input.form-control(
                            type="text"
                            id="lastName"
                            name="lastName"
                            value=contact.lastName
                            required
                        )

                .mb-3

                    label.form-label(for="email")

                        | E-Mail-Adresse

                    input.form-control(
                        type="email"
                        id="email"
                        name="email"
                        value=contact.email
                        required
                    )

                .mb-3

                    label.form-label(for="phone")

                        | Telefon

                    input.form-control(
                        type="text"
                        id="phone"
                        name="phone"
                        value=contact.phone
                    )

                .mb-3

                    label.form-label(for="mobile")

                        | Mobil

                    input.form-control(
                        type="text"
                        id="mobile"
                        name="mobile"
                        value=contact.mobile
                    )

                .mb-3

                    label.form-label

                        | Firma

                    input.form-control.vb-readonly(
                        type="text"
                        value=contact.company.companyName
                        readonly
                    )

                .mb-3

                    label.form-label

                        | Letzte Anmeldung

                    if portalAccount && portalAccount.lastLogin

                        input.form-control.vb-readonly(
                            type="text"
                            value=portalAccount.lastLogin.toLocaleString("de-DE")
                            readonly
                        )

                    else

                        input.form-control.vb-readonly(
                            type="text"
                            value="Noch keine Anmeldung"
                            readonly
                        )

                .mt-4

                    button.btn.btn-primary(type="submit")

                        i.bi.bi-floppy.me-2

                        | Änderungen speichern

                    a.btn.btn-outline-secondary.ms-2(
                        href="/portal/profile/password"
                    )

                        i.bi.bi-key.me-2

                        | Passwort ändern

    // =====================================================
    // Informationen per E-Mail
    // =====================================================

    - const subscribed = marketingConsent && marketingConsent.status === "granted"

    .card.shadow-sm.mt-4

        .card-header

            h5.mb-0

                i.bi.bi-envelope-paper.me-2

                | Informationen per E-Mail

        .card-body

            p.text-muted

                | Wir informieren Sie gelegentlich über Neuigkeiten, Sicherheitshinweise und Angebote rund um Ihre IT.
                | Sie können das hier jederzeit an- und wieder abbestellen.

            p

                | Aktuell:
                if subscribed

                    span.badge.bg-success.ms-2 Angemeldet

                else

                    span.badge.bg-secondary.ms-2 Nicht angemeldet

                if marketingConsent && marketingConsent.changedAt

                    small.text-muted.ms-2 seit #{new Date(marketingConsent.changedAt).toLocaleDateString("de-DE")}

            form(method="POST" action="/portal/profile/marketing")

                if subscribed

                    input(type="hidden" name="marketing" value="no")

                    button.btn.btn-outline-secondary(type="submit")

                        i.bi.bi-envelope-x.me-2

                        | Abmelden

                else

                    input(type="hidden" name="marketing" value="yes")

                    button.btn.btn-primary(type="submit")

                        i.bi.bi-envelope-check.me-2

                        | Informationen per E-Mail erhalten

            small.d-block.text-muted.mt-3

                | Hinweise zu Ihren Tickets (z. B. Eingangsbestätigungen) erhalten Sie unabhängig von dieser Einstellung.
