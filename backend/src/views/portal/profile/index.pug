extends ../layouts/main

block content

    .d-flex.justify-content-between.align-items-center.mb-4

        h1.mb-0 Mein Profil

        a.btn.btn-secondary(
            href="/portal"
        )

            i.bi.bi-arrow-left.me-2

            | Dashboard

    .card.shadow-sm

        .card-header

            h5.mb-0

                i.bi.bi-person.me-2

                | Persönliche Daten

        .card-body

            form(method="POST" action="/portal/profile")

                .row

                    .col-md-6.mb-3

                        label.form-label(for="firstName")

                            | Vorname

                        input.form-control(
                            type="text"
                            id="firstName"
                            name="firstName"
                            value=contact.firstName
                            required
                        )

                    .col-md-6.mb-3

                        label.form-label(for="lastName")

                            | Nachname

                        input.form-control(
                            type="text"
                            id="lastName"
                            name="lastName"
                            value=contact.lastName
                            required
                        )

                .mb-3

                    label.form-label(for="email")

                        | E-Mail-Adresse

                    input.form-control(
                        type="email"
                        id="email"
                        name="email"
                        value=contact.email
                        required
                    )

                .mb-3

                    label.form-label(for="phone")

                        | Telefon

                    input.form-control(
                        type="text"
                        id="phone"
                        name="phone"
                        value=contact.phone
                    )

                .mb-3

                    label.form-label(for="mobile")

                        | Mobil

                    input.form-control(
                        type="text"
                        id="mobile"
                        name="mobile"
                        value=contact.mobile
                    )

                .mb-3

                    label.form-label

                        | Firma

                    input.form-control.vb-readonly(
                        type="text"
                        value=contact.company.companyName
                        readonly
                    )

                .mb-3

                    label.form-label

                        | Letzte Anmeldung

                    if portalAccount && portalAccount.lastLogin

                        input.form-control.vb-readonly(
                            type="text"
                            value=portalAccount.lastLogin.toLocaleString("de-DE")
                            readonly
                        )

                    else

                        input.form-control.vb-readonly(
                            type="text"
                            value="Noch keine Anmeldung"
                            readonly
                        )

                .mt-4

                    button.btn.btn-primary(type="submit")

                        i.bi.bi-floppy.me-2

                        | Änderungen speichern

                    a.btn.btn-outline-secondary.ms-2(
                        href="/portal/profile/password"
                    )

                        i.bi.bi-key.me-2

                        | Passwort ändern