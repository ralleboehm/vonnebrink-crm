extends ../layouts/main

block content

    .d-flex.justify-content-between.align-items-center.mb-4

        h1.mb-0 Passwort ändern

        if !portalAccount || !portalAccount.mustChangePassword

            a.btn.btn-secondary(
                href="/portal/profile"
            )

                i.bi.bi-arrow-left.me-2

                | Profil

    .card.shadow-sm

        .card-header

            h5.mb-0

                i.bi.bi-key.me-2

                | Passwort ändern

        .card-body

            if portalAccount && portalAccount.mustChangePassword

                .alert.alert-warning

                    i.bi.bi-exclamation-triangle.me-2

                    | Willkommen im Kundenportal. Bitte vergeben Sie zunächst ein eigenes Passwort.

            if error

                .alert.alert-danger

                    i.bi.bi-exclamation-triangle.me-2

                    = error

            form(method="POST" action="/portal/profile/password")

                .mb-3

                    label.form-label(for="password")

                        | Neues Passwort

                    input.form-control(
                        type="password"
                        id="password"
                        name="password"
                        required
                        minlength="8"
                        autocomplete="new-password"
                    )

                .mb-4

                    label.form-label(for="passwordConfirm")

                        | Neues Passwort wiederholen

                    input.form-control(
                        type="password"
                        id="passwordConfirm"
                        name="passwordConfirm"
                        required
                        minlength="8"
                        autocomplete="new-password"
                    )

                button.btn.btn-primary(type="submit")

                    i.bi.bi-floppy.me-2

                    | Passwort speichern

                if !portalAccount || !portalAccount.mustChangePassword

                    a.btn.btn-secondary.ms-2(
                        href="/portal/profile"
                    )

                        | Abbrechen