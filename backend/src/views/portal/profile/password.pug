extends ../layouts/main

block content

    .d-flex.justify-content-between.align-items-center.mb-4

        h1.mb-0 Passwort ändern

        a.btn.btn-secondary(
            href="/portal/profile"
        )

            i.bi.bi-arrow-left.me-2

            | Profil

    .card.shadow-sm

        .card-header

            h5.mb-0

                i.bi.bi-key.me-2

                | Passwort ändern

        .card-body

            if error

                .alert.alert-danger

                    i.bi.bi-exclamation-triangle.me-2

                    = error

            form(method="POST" action="/portal/profile/password")

                .mb-3

                    label.form-label(for="currentPassword")

                        | Aktuelles Passwort

                    input.form-control(
                        type="password"
                        id="currentPassword"
                        name="currentPassword"
                        required
                        autocomplete="current-password"
                    )

                .mb-3

                    label.form-label(for="newPassword")

                        | Neues Passwort

                    input.form-control(
                        type="password"
                        id="newPassword"
                        name="newPassword"
                        required
                        minlength="8"
                        autocomplete="new-password"
                    )

                .mb-4

                    label.form-label(for="confirmPassword")

                        | Neues Passwort wiederholen

                    input.form-control(
                        type="password"
                        id="confirmPassword"
                        name="confirmPassword"
                        required
                        minlength="8"
                        autocomplete="new-password"
                    )

                button.btn.btn-primary(type="submit")

                    i.bi.bi-floppy.me-2

                    | Passwort ändern

                a.btn.btn-secondary.ms-2(
                    href="/portal/profile"
                )

                    | Abbrechen