extends layouts/main

block content

    .row.justify-content-center

        .col-md-6

            .card.shadow

                .card-header

                    h3.mb-0

                        i.bi.bi-key.me-2

                        | Passwort ändern

                .card-body

                    .alert.alert-warning

                        i.bi.bi-exclamation-triangle.me-2

                        | Aus Sicherheitsgründen müssen Sie beim ersten Login ein neues Passwort vergeben.

                    if error

                        .alert.alert-danger

                            = error

                    form(method="POST" action="/portal/change-password")

                        .mb-3

                            label.form-label(for="password")

                                | Neues Passwort

                            input.form-control(
                                type="password"
                                id="password"
                                name="password"
                                required
                                autofocus
                            )

                        .mb-3

                            label.form-label(for="passwordConfirm")

                                | Passwort wiederholen

                            input.form-control(
                                type="password"
                                id="passwordConfirm"
                                name="passwordConfirm"
                                required
                            )

                        .d-grid

                            button.btn.btn-primary(type="submit")

                                i.bi.bi-check-lg.me-2

                                | Passwort speichern