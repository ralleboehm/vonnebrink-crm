doctype html
html(lang="de")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1")

        title #{title || "Vonnebrink CRM"}

        // Bootstrap
        link(
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
            rel="stylesheet"
        )

        // Bootstrap Icons
        link(
            href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"
            rel="stylesheet"
        )

        // Google Fonts
        link(rel="preconnect" href="https://fonts.googleapis.com")
        link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)

        link(
            href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap"
            rel="stylesheet"
        )

        // Eigenes Stylesheet
        link(
            rel="stylesheet"
            href="/css/vonnebrink.css"
        )

    body

        nav.navbar.navbar-expand-lg.navbar-light.bg-white.shadow-sm

            .container-fluid

                a.navbar-brand.d-flex.align-items-center(href="/")

                    img(
                        src="/images/logo-only.png"
                        alt="Vonnebrink IT Operations"
                        height="40"
                        class="me-3"
                    )

                button.navbar-toggler(
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav"
                    aria-controls="navbarNav"
                    aria-expanded="false"
                    aria-label="Navigation umschalten"
                )

                    span.navbar-toggler-icon

                .collapse.navbar-collapse#navbarNav

                    ul.navbar-nav.me-auto

                        li.nav-item
                            a.nav-link(href="/")
                                i.bi.bi-speedometer2.me-1
                                | Dashboard

                        li.nav-item
                            a.nav-link(href="/companies")
                                i.bi.bi-buildings.me-1
                                | Firmen

                        li.nav-item
                            a.nav-link(href="/contacts")
                                i.bi.bi-people.me-1
                                | Kontakte

                        li.nav-item
                            a.nav-link(href="/tickets")
                                i.bi.bi-ticket-detailed.me-1
                                | Tickets

                        if session && session.user && session.user.role === "admin"

                            li.nav-item
                                a.nav-link(href="/users")
                                    i.bi.bi-person-gear.me-1
                                    | Benutzer

                    if session && session.user

                        ul.navbar-nav

                            li.nav-item.dropdown

                                a.nav-link.dropdown-toggle(
                                    href="#"
                                    role="button"
                                    data-bs-toggle="dropdown"
                                )

                                    i.bi.bi-person-circle.me-2

                                    | #{session.user.firstName} #{session.user.lastName}

                                ul.dropdown-menu.dropdown-menu-end

                                    li
                                        h6.dropdown-header
                                            | #{session.user.role}

                                    li
                                        hr.dropdown-divider

                                    li
                                        a.dropdown-item.disabled(href="#")

                                            i.bi.bi-person.me-2

                                            | Mein Profil

                                    li
                                        a.dropdown-item.disabled(href="#")

                                            i.bi.bi-key.me-2

                                            | Passwort ändern

                                    li
                                        hr.dropdown-divider

                                    li
                                        a.dropdown-item.text-danger(href="/logout")

                                            i.bi.bi-box-arrow-right.me-2

                                            | Abmelden

        main.container.py-4

            block content

        script(
            src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        )