extends ../layouts/guest

block content

    .card.login-card.shadow-lg

        .card-header

            //- Logo später hier ablegen:
            //- /public/images/logo.png

            img.crm-logo(
                src="/images/logo.png"
                alt="Vonnebrink IT Operations"
                onerror="this.style.display='none'"
            )

            h2.mb-1 Vonnebrink CRM

            p.mb-0.opacity-75
                | IT Operations

        .card-body

            if error

                .alert.alert-danger
                    = error

            form(method="POST" action="/login")

                .mb-3

                    label.form-label(for="username")
                        | Benutzername

                    input.form-control.form-control-lg(
                        type="text"
                        id="username"
                        name="username"
                        autocomplete="username"
                        required
                        autofocus
                    )

                .mb-4

                    label.form-label(for="password")
                        | Passwort

                    input.form-control.form-control-lg(
                        type="password"
                        id="password"
                        name="password"
                        autocomplete="current-password"
                        required
                    )

                .d-grid

                    button.btn.btn-primary.btn-lg(type="submit")
                        | Anmelden

            .login-footer

                hr

                small.text-muted
                    | © #{new Date().getFullYear()} Vonnebrink IT Operations

                br

                small.text-muted
                    | CRM Version 0.1 Alpha