doctype html
html(lang="de")
    head

        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1")

        title #{title || "Vonnebrink CRM"}

        // Bootstrap
        link(
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
            rel="stylesheet"
        )

        // Bootstrap Icons
        link(
            href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"
            rel="stylesheet"
        )

        // Google Fonts
        link(rel="preconnect" href="https://fonts.googleapis.com")
        link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)

        link(
            href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap"
            rel="stylesheet"
        )

        // Eigenes Stylesheet
        link(
            rel="stylesheet"
            href="/css/vonnebrink.css"
        )

    body

        nav.navbar.navbar-expand-lg.navbar-light.bg-white.shadow-sm

            .container-fluid

                a.navbar-brand.d-flex.align-items-center(href="/crm")

                    img(
                        src="/images/logo-only.png"
                        alt="Vonnebrink IT Operations"
                        height="40"
                        class="me-3"
                    )

                button.navbar-toggler(
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav"
                    aria-controls="navbarNav"
                    aria-expanded="false"
                    aria-label="Navigation umschalten"
                )

                    span.navbar-toggler-icon

                .collapse.navbar-collapse#navbarNav

                    ul.navbar-nav.me-auto

                        li.nav-item
                            a.nav-link(href="/crm")
                                i.bi.bi-speedometer2.me-1
                                | Dashboard

                        li.nav-item
                            a.nav-link(href="/crm/companies")
                                i.bi.bi-buildings.me-1
                                | Firmen

                        li.nav-item
                            a.nav-link(href="/crm/contacts")
                                i.bi.bi-people.me-1
                                | Kontakte

                        li.nav-item
                            a.nav-link(href="/crm/tickets")
                                i.bi.bi-ticket-detailed.me-1
                                | Tickets

                        li.nav-item
                            a.nav-link(href="/crm/assets")
                                i.bi.bi-pc-display.me-1
                                | Assets

                        if session && session.user && session.user.role === "admin"

                            li.nav-item

                                a.nav-link(href="/crm/users")

                                    i.bi.bi-person-gear.me-1

                                    | Benutzer

                            li.nav-item

                                a.nav-link(href="/crm/import")

                                    i.bi.bi-upload.me-1

                                    | Import & Export

                            li.nav-item

                                a.nav-link(href="/crm/integrations/action1")

                                    i.bi.bi-arrow-repeat.me-1

                                    | Action1

                    if session && session.user

                        form.position-relative.me-lg-3.my-2.my-lg-0#globalSearchForm(
                            action="/crm/search"
                            method="GET"
                            role="search"
                        )

                            .input-group.input-group-sm

                                span.input-group-text
                                    i.bi.bi-search

                                input.form-control#globalSearchInput(
                                    type="search"
                                    name="q"
                                    value=(typeof searchQuery !== "undefined" ? searchQuery : "")
                                    placeholder="Suchen ( / )"
                                    autocomplete="off"
                                    maxlength="100"
                                    aria-label="Suche in Firmen, Kontakten, Tickets und Assets"
                                    style="min-width: 240px;"
                                )

                            #globalSearchResults.list-group.shadow.position-absolute.d-none(
                                style="top: 100%; left: 0; right: 0; z-index: 1050; max-height: 70vh; overflow-y: auto;"
                            )

                    if session && session.user

                        ul.navbar-nav.flex-row.align-items-center

                            if notificationBell

                                include ../partials/notificationBell

                            li.nav-item.dropdown

                                a.nav-link.dropdown-toggle.d-flex.align-items-center(
                                    href="#"
                                    role="button"
                                    data-bs-toggle="dropdown"
                                )

                                    .rounded-circle.bg-primary.text-white.d-flex.justify-content-center.align-items-center.me-2(
                                        style="width:34px;height:34px;font-weight:600;"
                                    )

                                        = session.user.firstName.charAt(0) + session.user.lastName.charAt(0)

                                    span

                                        | #{session.user.firstName} #{session.user.lastName}

                                ul.dropdown-menu.dropdown-menu-end.shadow

                                    li.px-3.py-2

                                        strong.d-block

                                            | #{session.user.firstName} #{session.user.lastName}

                                        small.text-muted

                                            | #{session.user.username}

                                    li

                                        hr.dropdown-divider

                                    li

                                        h6.dropdown-header

                                            if session.user.role === "admin"

                                                | Administrator

                                            else if session.user.role === "technician"

                                                | Techniker

                                            else

                                                | Benutzer

                                    li

                                        hr.dropdown-divider

                                    li

                                        a.dropdown-item(href="/crm/profile")

                                            i.bi.bi-person.me-2

                                            | Mein Profil

                                    li

                                        a.dropdown-item(href="/crm/profile/password")

                                            i.bi.bi-key.me-2

                                            | Passwort ändern

                                    li

                                        hr.dropdown-divider

                                    li

                                        a.dropdown-item.text-danger(href="/crm/logout")

                                            i.bi.bi-box-arrow-right.me-2

                                            | Abmelden

        main.container.py-4

            block content

        script(
            src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        )

        if session && session.user
            script(src="/js/search.js" defer)

        block scripts