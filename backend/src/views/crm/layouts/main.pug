doctype html
html(lang="de")
    head

        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1")

        title #{title ? title + " – " : ""}Vonnebrink CRM

        link(rel="icon" type="image/png" href="/images/logo-mark.png")

        // Bootstrap
        link(
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
            rel="stylesheet"
        )

        // Bootstrap Icons
        link(
            href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"
            rel="stylesheet"
        )

        // Google Fonts
        link(rel="preconnect" href="https://fonts.googleapis.com")
        link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)

        link(
            href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Source+Sans+3:wght@400;600;700&display=swap"
            rel="stylesheet"
        )

        // Eigenes Stylesheet
        link(
            rel="stylesheet"
            href="/css/vonnebrink.css"
        )

    body.vb-crm

        nav.navbar.navbar-expand-lg.navbar-dark.vb-crm-nav

            .container-fluid

                a.navbar-brand.d-flex.align-items-center.me-4(href="/crm")

                    img.vb-crm-logo(
                        src="/images/logo-wordmark-light.png"
                        alt="Vonnebrink IT Operations"
                    )

                    span.vb-crm-tag CRM

                button.navbar-toggler(
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav"
                    aria-controls="navbarNav"
                    aria-expanded="false"
                    aria-label="Navigation umschalten"
                )

                    span.navbar-toggler-icon

                .collapse.navbar-collapse#navbarNav

                    ul.navbar-nav.me-auto

                        li.nav-item
                            a.nav-link(href="/crm")
                                i.bi.bi-speedometer2.me-1
                                | Dashboard

                        li.nav-item.dropdown
                            a.nav-link.dropdown-toggle(href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false")
                                i.bi.bi-buildings.me-1
                                | Kunden
                            ul.dropdown-menu.shadow
                                li
                                    a.dropdown-item(href="/crm/companies")
                                        i.bi.bi-buildings.me-2
                                        | Firmen
                                li
                                    a.dropdown-item(href="/crm/contacts")
                                        i.bi.bi-people.me-2
                                        | Kontakte
                                if can("contracts.view")
                                    li
                                        a.dropdown-item(href="/crm/contracts")
                                            i.bi.bi-file-earmark-text.me-2
                                            | Verträge

                        if can("tickets.list") || can("assets.view")

                            li.nav-item.dropdown
                                a.nav-link.dropdown-toggle(href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false")
                                    i.bi.bi-tools.me-1
                                    | Service
                                ul.dropdown-menu.shadow
                                    if can("tickets.list")
                                        li
                                            a.dropdown-item(href="/crm/tickets")
                                                i.bi.bi-ticket-detailed.me-2
                                                | Tickets
                                    if can("assets.view")
                                        li
                                            a.dropdown-item(href="/crm/assets")
                                                i.bi.bi-pc-display.me-2
                                                | Assets

                        if can("sales.view")

                            li.nav-item.dropdown
                                a.nav-link.dropdown-toggle(href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false")
                                    i.bi.bi-briefcase.me-1
                                    | Vertrieb
                                ul.dropdown-menu.shadow
                                    li
                                        a.dropdown-item(href="/crm/sales")
                                            i.bi.bi-kanban.me-2
                                            | Pipeline
                                    li
                                        a.dropdown-item(href="/crm/sales/list")
                                            i.bi.bi-list-ul.me-2
                                            | Alle Verkaufschancen
                                    if can("sales.edit")
                                        li
                                            hr.dropdown-divider
                                        li
                                            a.dropdown-item(href="/crm/sales/new")
                                                i.bi.bi-plus-lg.me-2
                                                | Neue Verkaufschance

                        if can("marketing.view")

                            li.nav-item.dropdown
                                a.nav-link.dropdown-toggle(href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false")
                                    i.bi.bi-megaphone.me-1
                                    | Marketing
                                ul.dropdown-menu.shadow
                                    li
                                        a.dropdown-item(href="/crm/marketing/campaigns")
                                            i.bi.bi-envelope-paper.me-2
                                            | Kampagnen
                                    li
                                        a.dropdown-item(href="/crm/marketing")
                                            i.bi.bi-person-check.me-2
                                            | Empfänger
                                    li
                                        a.dropdown-item(href="/crm/marketing/groups")
                                            i.bi.bi-tags.me-2
                                            | Gruppen

                        if can("surveys.view")

                            li.nav-item
                                a.nav-link(href="/crm/surveys")
                                    i.bi.bi-emoji-smile.me-1
                                    | Umfragen

                        if session && session.user && session.user.role === "admin"

                            li.nav-item.dropdown
                                a.nav-link.dropdown-toggle(href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false")
                                    i.bi.bi-gear.me-1
                                    | Verwaltung
                                ul.dropdown-menu.shadow
                                    li
                                        a.dropdown-item(href="/crm/users")
                                            i.bi.bi-person-gear.me-2
                                            | Benutzer
                                    li
                                        a.dropdown-item(href="/crm/import")
                                            i.bi.bi-upload.me-2
                                            | Import & Export
                                    li
                                        a.dropdown-item(href="/crm/integrations/action1")
                                            i.bi.bi-arrow-repeat.me-2
                                            | Action1
                                    li
                                        hr.dropdown-divider
                                    if can("email.log")
                                        li
                                            a.dropdown-item(href="/crm/email-log")
                                                i.bi.bi-envelope-check.me-2
                                                | E-Mail-Protokoll

                    if session && session.user

                        form.position-relative.me-lg-3.my-2.my-lg-0#globalSearchForm(
                            action="/crm/search"
                            method="GET"
                            role="search"
                        )

                            .input-group.input-group-sm

                                span.input-group-text
                                    i.bi.bi-search

                                input.form-control#globalSearchInput(
                                    type="search"
                                    name="q"
                                    value=(typeof searchQuery !== "undefined" ? searchQuery : "")
                                    placeholder="Suchen ( / )"
                                    autocomplete="off"
                                    maxlength="100"
                                    aria-label="Suche in Firmen, Kontakten, Tickets und Assets"
                                    style="min-width: 240px;"
                                )

                            #globalSearchResults.list-group.shadow.position-absolute.d-none(
                                style="top: 100%; left: 0; right: 0; z-index: 1050; max-height: 70vh; overflow-y: auto;"
                            )

                    if session && session.user

                        ul.navbar-nav.flex-row.align-items-center

                            if notificationBell

                                include ../partials/notificationBell

                            li.nav-item.dropdown

                                a.nav-link.dropdown-toggle.d-flex.align-items-center(
                                    href="#"
                                    role="button"
                                    data-bs-toggle="dropdown"
                                )

                                    .rounded-circle.bg-primary.text-white.d-flex.justify-content-center.align-items-center.me-2(
                                        style="width:34px;height:34px;font-weight:600;"
                                    )

                                        = session.user.firstName.charAt(0) + session.user.lastName.charAt(0)

                                    span

                                        | #{session.user.firstName} #{session.user.lastName}

                                ul.dropdown-menu.dropdown-menu-end.shadow

                                    li.px-3.py-2

                                        strong.d-block

                                            | #{session.user.firstName} #{session.user.lastName}

                                        small.text-muted

                                            | #{session.user.username}

                                    li

                                        hr.dropdown-divider

                                    li

                                        h6.dropdown-header

                                            if session.user.role === "admin"

                                                | Administrator

                                            else if session.user.role === "technician"

                                                | Techniker

                                            else if session.user.role === "sales"

                                                | Vertrieb

                                            else

                                                | Benutzer

                                    li

                                        hr.dropdown-divider

                                    li

                                        a.dropdown-item(href="/crm/profile")

                                            i.bi.bi-person.me-2

                                            | Mein Profil

                                    li

                                        a.dropdown-item(href="/crm/profile/password")

                                            i.bi.bi-key.me-2

                                            | Passwort ändern

                                    if can("email.log")

                                        li

                                            a.dropdown-item(href="/crm/email-log")

                                                i.bi.bi-envelope-check.me-2

                                                | E-Mail-Protokoll

                                    li

                                        hr.dropdown-divider

                                    li

                                        a.dropdown-item.text-danger(href="/crm/logout")

                                            i.bi.bi-box-arrow-right.me-2

                                            | Abmelden

        main.container.py-4

            block content

        script(
            src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        )

        if session && session.user
            script(src="/js/search.js" defer)

        block scripts