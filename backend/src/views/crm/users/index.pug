extends ../layouts/main

block content

    .d-flex.justify-content-between.align-items-center.mb-4

        h1.mb-0 Benutzer

        a.btn.btn-primary(href="/crm/users/new")

            i.bi.bi-plus-circle.me-2

            | Neuer Benutzer

    if users.length

        .card.shadow-sm

            .card-body.p-0

                table.table.table-hover.table-striped.mb-0

                    thead.table-dark

                        tr
                            th Benutzername
                            th Name
                            th E-Mail
                            th Rolle
                            th Status
                            th Letzte Anmeldung
                            th.text-end Aktionen

                    tbody

                        each user in users

                            tr

                                td= user.username

                                td

                                    a.text-decoration-none(
                                        href=`/crm/users/${user._id}`
                                    )

                                        strong #{user.firstName} #{user.lastName}

                                td= user.email

                                td

                                    case user.role

                                        when "admin"
                                            span.badge.bg-danger Administrator

                                        when "technician"
                                            span.badge.bg-primary Techniker

                                        default
                                            span.badge.bg-secondary Benutzer

                                td

                                    if user.active
                                        span.badge.bg-success Aktiv
                                    else
                                        span.badge.bg-secondary Deaktiviert

                                td

                                    if user.lastLogin
                                        = user.lastLogin.toLocaleString("de-DE")
                                    else
                                        span.text-muted Noch nie

                                td.text-end

                                    a.btn.btn-sm.btn-outline-primary.me-1(
                                        href=`/crm/users/${user._id}`
                                    )

                                        i.bi.bi-eye.me-1

                                        | Anzeigen

                                    a.btn.btn-sm.btn-outline-secondary.me-1(
                                        href=`/crm/users/${user._id}/edit`
                                    )

                                        i.bi.bi-pencil.me-1

                                        | Bearbeiten

                                    if user.active

                                        form(
                                            action=`/crm/users/${user._id}/deactivate`
                                            method="POST"
                                            style="display:inline;"
                                            onsubmit="return confirm('Benutzer wirklich deaktivieren?');"
                                        )

                                            button.btn.btn-sm.btn-outline-danger(type="submit")

                                                i.bi.bi-person-x.me-1

                                                | Deaktivieren

    else

        .alert.alert-info

            i.bi.bi-info-circle.me-2

            | Es sind noch keine Benutzer vorhanden.