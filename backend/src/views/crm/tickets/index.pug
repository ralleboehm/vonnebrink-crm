extends ../layouts/main

block content

    - const canOpen = can("tickets.view")

    .d-flex.justify-content-between.align-items-center.mb-4

        h1.mb-0
            i.bi.bi-ticket-detailed.me-2
            | Tickets

        if can("tickets.edit")

            a.btn.btn-primary(href="/crm/tickets/new")

                i.bi.bi-plus-circle.me-2

                | Neues Ticket

    // =====================================================
    // Suche & Filter
    // =====================================================

    .card.shadow-sm.mb-4

        .card-body

            form(method="GET" action="/crm/tickets")

                .row.g-3.align-items-end

                    .col-lg-5

                        label.form-label Suchbegriff

                        input.form-control(
                            type="text"
                            name="search"
                            placeholder="Ticketnummer, Betreff oder Beschreibung..."
                            value=filters.search
                        )

                    .col-lg-3

                        label.form-label Status

                        select.form-select(name="status")

                            option(value="") Alle
                            option(value="open" selected=filters.status==="open") Offen
                            option(value="in_progress" selected=filters.status==="in_progress") In Bearbeitung
                            option(value="waiting" selected=filters.status==="waiting") Wartend
                            option(value="resolved" selected=filters.status==="resolved") Gelöst
                            option(value="closed" selected=filters.status==="closed") Geschlossen

                    .col-lg-2

                        label.form-label Priorität

                        select.form-select(name="priority")

                            option(value="") Alle
                            option(value="urgent" selected=filters.priority==="urgent") Dringend
                            option(value="high" selected=filters.priority==="high") Hoch
                            option(value="normal" selected=filters.priority==="normal") Normal
                            option(value="low" selected=filters.priority==="low") Niedrig

                    .col-lg-2

                        .d-grid.gap-2

                            button.btn.btn-primary(type="submit")

                                i.bi.bi-search.me-2

                                | Suchen

                            a.btn.btn-outline-secondary(href="/crm/tickets")

                                i.bi.bi-arrow-clockwise.me-2

                                | Zurücksetzen

    // =====================================================
    // Ticketliste
    // =====================================================

    .card.shadow-sm

        .card-body.p-0

            if tickets.length

                .table-responsive

                    table.table.table-hover.align-middle.mb-0

                        thead.table-light

                            tr
                                th Ticket
                                th Betreff
                                th Firma
                                th Priorität
                                th Status
                                th Bearbeiter
                                th.text-end Aktionen

                        tbody

                            each ticket in tickets

                                tr

                                    td
                                        if canOpen
                                            a.text-decoration-none(
                                                href=`/crm/tickets/${ticket._id}`
                                            )
                                                strong= ticket.ticketNumber
                                        else
                                            strong= ticket.ticketNumber

                                    td= ticket.subject

                                    td
                                        if ticket.company
                                            = ticket.company.companyName
                                        else
                                            span.text-muted -

                                    td
                                        if ticket.priority === "urgent"
                                            span.badge.bg-danger Dringend
                                        else if ticket.priority === "high"
                                            span.badge.bg-warning.text-dark Hoch
                                        else if ticket.priority === "normal"
                                            span.badge.bg-primary Normal
                                        else
                                            span.badge.bg-secondary Niedrig

                                    td
                                        if ticket.status === "open"
                                            span.badge.bg-primary Offen
                                        else if ticket.status === "in_progress"
                                            span.badge.bg-warning.text-dark In Bearbeitung
                                        else if ticket.status === "waiting"
                                            span.badge.bg-secondary Wartend
                                        else if ticket.status === "resolved"
                                            span.badge.bg-success Gelöst
                                        else
                                            span.badge.bg-dark Geschlossen

                                    td
                                        if ticket.assignedTo
                                            | #{ticket.assignedTo.firstName} #{ticket.assignedTo.lastName}
                                        else
                                            span.text-muted Nicht zugewiesen

                                    td.text-end

                                        if canOpen

                                            a.btn.btn-sm.btn-outline-primary.me-2(
                                                href=`/crm/tickets/${ticket._id}`
                                            )

                                                i.bi.bi-eye.me-1

                                                | Anzeigen

                                        if can("tickets.edit")

                                            a.btn.btn-sm.btn-outline-secondary(
                                                href=`/crm/tickets/${ticket._id}/edit`
                                            )

                                                i.bi.bi-pencil.me-1

                                                | Bearbeiten

            else

                .p-5.text-center

                    i.bi.bi-inbox.display-4.text-muted

                    h5.mt-3 Keine Tickets gefunden

                    if filters.search || filters.status || filters.priority

                        p.text-muted
                            | Für die gewählten Filter wurden keine Tickets gefunden.

                        a.btn.btn-outline-primary.mt-2(
                            href="/crm/tickets"
                        )

                            i.bi.bi-arrow-clockwise.me-2

                            | Filter zurücksetzen

                    else

                        p.text-muted
                            | Es sind noch keine Tickets vorhanden.

                        if can("tickets.edit")

                            a.btn.btn-primary.mt-2(
                                href="/crm/tickets/new"
                            )

                                i.bi.bi-plus-circle.me-2

                                | Erstes Ticket anlegen