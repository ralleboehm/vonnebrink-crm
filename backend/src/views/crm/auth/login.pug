extends ../layouts/guest

block content

    .card.login-card.shadow-lg

        .card-header

            img.vb-login-logo(
                src="/images/logo-wordmark.png"
                alt="Vonnebrink IT Operations"
            )

            .mt-3

                span.vb-crm-tag.ms-0 CRM · intern

        .card-body

            if error

                .alert.alert-danger
                    = error

            form(method="POST" action="/crm/login")

                .mb-3

                    label.form-label(for="username")
                        | Benutzername

                    input.form-control.form-control-lg(
                        type="text"
                        id="username"
                        name="username"
                        autocomplete="username"
                        required
                        autofocus
                    )

                .mb-4

                    label.form-label(for="password")
                        | Passwort

                    input.form-control.form-control-lg(
                        type="password"
                        id="password"
                        name="password"
                        autocomplete="current-password"
                        required
                    )

                .d-grid

                    button.btn.btn-primary.btn-lg(type="submit")
                        | Anmelden

            .login-footer

                hr

                small.text-muted
                    | © #{new Date().getFullYear()} Vonnebrink IT Operations

                br

                small.text-muted
                    | CRM Version 0.1 Alpha