extends ../layouts/main

block content

    .d-flex.justify-content-between.align-items-center.mb-4

        h1.mb-0 Neues Asset

        a.btn.btn-outline-secondary(href="/crm/assets")

            i.bi.bi-arrow-left.me-2

            | Zurück

    form(method="POST" action="/crm/assets")

        include _form

        .mb-5

            button.btn.btn-primary(type="submit")

                i.bi.bi-check-lg.me-2

                | Asset anlegen

            a.btn.btn-outline-secondary.ms-2(href="/crm/assets") Abbrechen
