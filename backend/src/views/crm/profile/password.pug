extends ../layouts/main

block content

    .d-flex.justify-content-between.align-items-center.mb-4

        h1.mb-0 Passwort ändern

        a.btn.btn-secondary(
            href="/crm/profile"
        )

            i.bi.bi-arrow-left.me-2

            | Zurück

    .card.shadow-sm

        .card-header

            h5.mb-0

                i.bi.bi-key.me-2

                | Passwort ändern

        .card-body

            form(method="POST" action="/crm/profile/password")

                .mb-3

                    label.form-label(for="currentPassword")

                        | Aktuelles Passwort

                    input.form-control(
                        type="password"
                        id="currentPassword"
                        name="currentPassword"
                        autocomplete="current-password"
                        required
                    )

                .mb-3

                    label.form-label(for="newPassword")

                        | Neues Passwort

                    input.form-control(
                        type="password"
                        id="newPassword"
                        name="newPassword"
                        autocomplete="new-password"
                        minlength="8"
                        required
                    )

                .form-text.mb-3

                    | Das Passwort sollte mindestens 8 Zeichen lang sein.

                .mb-4

                    label.form-label(for="confirmPassword")

                        | Neues Passwort wiederholen

                    input.form-control(
                        type="password"
                        id="confirmPassword"
                        name="confirmPassword"
                        autocomplete="new-password"
                        minlength="8"
                        required
                    )

                hr

                .d-flex.justify-content-between.align-items-center

                    a.btn.btn-outline-secondary(
                        href="/crm/profile"
                    )

                        Abbrechen

                    button.btn.btn-primary(type="submit")

                        i.bi.bi-key.me-2

                        | Passwort ändern