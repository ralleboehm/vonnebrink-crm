extends ../layouts/main

block content

    h1.mb-4 CSV-Import Vorschau

    .card.shadow-sm.mb-4

        .card-header

            h5.mb-0 CSV-Datei analysiert

        .card-body

            .row.mb-4

                .col-md-3

                    strong Datensätze

                    p.mb-0= totalRows

                .col-md-3

                    strong Trennzeichen

                    p.mb-0= delimiter

            if headers.length

                h5.mb-3 Erkannte Spalten

                table.table.table-bordered.table-hover

                    thead

                        tr

                            each header in headers

                                th= header

                    tbody

                        each row in preview

                            tr

                                each value in row

                                    td= value

    if headers.length

        .card.shadow-sm

            .card-header

                h5.mb-0 Feldzuordnung

            .card-body

                form

                    table.table.table-striped.align-middle

                        thead

                            tr

                                th(style="width:40%") CSV-Spalte
                                th(style="width:60%") CRM-Feld

                        tbody

                            each header in headers

                                tr

                                    td

                                        strong= header

                                    td

                                        select.form-select(name=header)

                                            option(value="ignore") -- ignorieren --

                                            option(value="companyName") Firmenname
                                            option(value="email") E-Mail
                                            option(value="phone") Telefon
                                            option(value="website") Webseite
                                            option(value="street") Straße
                                            option(value="houseNumber") Hausnummer
                                            option(value="postalCode") PLZ
                                            option(value="city") Ort
                                            option(value="country") Land
                                            option(value="notes") Notizen

                    .mt-4.text-end

                        button.btn.btn-primary(
                            type="submit"
                            disabled
                        )

                            i.bi.bi-arrow-right-circle.me-2

                            | Weiter (folgt im nächsten Schritt)