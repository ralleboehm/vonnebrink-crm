extends ../layouts/main

block content

    .d-flex.justify-content-between.align-items-center.mb-4

        h1.mb-0

            i.bi.bi-building-add.me-2

            | Firmen importieren

        a.btn.btn-secondary(
            href="/crm/import"
        )

            i.bi.bi-arrow-left.me-2

            | Zurück

    .card.shadow-sm

        .card-header

            h5.mb-0

                i.bi.bi-upload.me-2

                | CSV-Datei auswählen

        .card-body

            p.text-muted

                | Unterstützt werden CSV-Dateien mit UTF-8 oder Windows-1252.
                | Das Trennzeichen wird automatisch erkannt.

            form(
                method="POST"
                action="/crm/import/companies"
                enctype="multipart/form-data"
            )

                .mb-4

                    label.form-label(for="csvFile")

                        | CSV-Datei

                    input.form-control(
                        type="file"
                        id="csvFile"
                        name="csvFile"
                        accept=".csv,.txt"
                        required
                    )

                .d-flex.justify-content-end

                    button.btn.btn-primary(type="submit")

                        i.bi.bi-upload.me-2

                        | Datei hochladen

    .card.mt-4.border-0.bg-light

        .card-body

            h5

                i.bi.bi-info-circle.me-2.text-primary

                | Geplanter Ablauf

            ol.mb-0

                li CSV-Datei auswählen

                li Vorschau anzeigen

                li Felder zuordnen

                li Import starten

                li Ergebnis anzeigen