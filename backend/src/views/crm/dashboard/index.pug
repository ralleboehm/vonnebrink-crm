extends ../layouts/main

include ../assets/_mixins
include ../contracts/_mixins

//- Kennzahl-Kachel; die ganze Kachel ist ein Link
mixin kpi(label, value, icon, href, tone)
    a.card.shadow-sm.h-100.text-decoration-none.text-reset(href=href)
        .card-body.d-flex.align-items-center
            .rounded-3.d-flex.align-items-center.justify-content-center.me-3.flex-shrink-0(
                class=`bg-${tone || "primary"}-subtle text-${tone || "primary"}`
                style="width: 48px; height: 48px;"
            )
                i.bi.fs-4(class=icon)
            div
                .text-muted.small= label
                .fs-3.fw-semibold.lh-1= value

//- Kleine Zahl mit Beschriftung im Asset-Block
mixin stat(label, value, href, tone)
    a.d-block.text-decoration-none.text-reset.border.rounded-3.p-3.h-100(href=href)
        .text-muted.small= label
        .fs-4.fw-semibold(class=tone ? `text-${tone}` : null)= value

//- Ticketliste für Meine/Unzugewiesene Tickets
mixin ticketList(tickets, emptyText)
    if tickets.length
        ul.list-group.list-group-flush
            each ticket in tickets
                li.list-group-item.d-flex.justify-content-between.align-items-start.gap-2
                    div
                        a.fw-semibold.text-decoration-none(href=`/crm/tickets/${ticket._id}`)= ticket.ticketNumber
                        span.ms-2= ticket.subject
                        if ticket.company
                            br
                            small.text-muted= ticket.company.companyName
                    span.badge.text-nowrap(class=ticket.priority === "urgent" ? "bg-danger" : (ticket.priority === "high" ? "bg-warning text-dark" : "bg-light text-dark border"))
                        = ({ urgent: "Dringend", high: "Hoch", normal: "Normal", low: "Niedrig" })[ticket.priority] || ticket.priority
    else
        .p-4.text-center.text-muted
            i.bi.bi-check2-circle.fs-2.d-block.mb-2.text-success
            = emptyText

block content

    - const multi = sections.length > 1

    .d-flex.justify-content-between.align-items-center.mb-4

        h1.mb-0 Dashboard

        small.text-muted= labels.formatDateTime(new Date())

    if !cards.length

        .card.shadow-sm

            .card-body.text-muted Für Ihre Rolle gibt es noch keine Dashboard-Karten.

    each section in sections

        if multi

            h2.h5.text-muted.text-uppercase.small.fw-semibold.mt-2.mb-3.vb-dashboard-section

                i.bi.me-2(class=section.icon)

                = section.label

        //- =================================================
        //- Technik
        //- =================================================

        if section.key === "technik"

            if show("techKpis")

                .row.g-3.mb-4

                    .col-xl-3.col-md-6
                        +kpi("Meine Tickets", techKpis.mine, "bi-person-check", "#my-tickets", techKpis.mine ? "primary" : "success")

                    .col-xl-3.col-md-6
                        +kpi("Unzugewiesen", techKpis.unassigned, "bi-inbox", "#unassigned-tickets", techKpis.unassigned ? "danger" : "success")

                    .col-xl-3.col-md-6
                        +kpi("Dringend / hoch", techKpis.urgent, "bi-exclamation-octagon", "/crm/tickets?priority=urgent", techKpis.urgent ? "danger" : "success")

                    .col-xl-3.col-md-6
                        +kpi("In Bearbeitung", techKpis.inProgress, "bi-hourglass-split", "/crm/tickets?status=in_progress", "warning")

            if show("myTickets") || show("unassigned")

                .row.g-3.mb-4

                    if show("myTickets")

                        .col-lg-6#my-tickets

                            .card.shadow-sm.h-100

                                .card-header.d-flex.justify-content-between.align-items-center

                                    h5.mb-0

                                        i.bi.bi-person-check.me-2

                                        | Meine offenen Tickets

                                    a.btn.btn-sm.btn-outline-primary(href="/crm/tickets") Alle Tickets

                                +ticketList(myTickets, "Keine offenen Tickets auf Ihrem Tisch.")

                    if show("unassigned")

                        .col-lg-6#unassigned-tickets

                            .card.shadow-sm.h-100

                                .card-header

                                    h5.mb-0

                                        i.bi.bi-inbox.me-2

                                        | Noch niemandem zugewiesen

                                +ticketList(unassignedTickets, "Alle offenen Tickets sind verteilt.")

            if show("attention") || show("assets")

                .row.g-3.mb-4

                    if show("assets")


                        .col-lg-7

                            .card.shadow-sm.h-100

                                .card-header.d-flex.justify-content-between.align-items-center

                                    h5.mb-0

                                        i.bi.bi-pc-display.me-2

                                        | Verwaltete Assets

                                    a.btn.btn-sm.btn-outline-primary(href="/crm/assets") Alle Assets

                                .card-body

                                    .d-flex.align-items-baseline.mb-3

                                        span.display-5.fw-semibold.me-2= assetSummary.total

                                        span.text-muted

                                            | Assets gesamt · #{assetSummary.active} in Betrieb

                                    .row.g-2

                                        .col-6.col-md-3
                                            +stat("Arbeitsplätze", assetSummary.workstations, "/crm/assets?status=active")

                                        .col-6.col-md-3
                                            +stat("Server & VMs", assetSummary.servers, "/crm/assets?status=active")

                                        .col-6.col-md-3
                                            +stat("Online", assetSummary.online, "/crm/assets?online=online", "success")

                                        .col-6.col-md-3
                                            +stat("Offline", assetSummary.offline, "/crm/assets?online=offline", assetSummary.offline ? "secondary" : null)

                                    if assetSummary.criticalUpdates || assetSummary.rebootRequired || assetSummary.warrantyExpired

                                        .d-flex.flex-wrap.gap-2.mt-3

                                            if assetSummary.criticalUpdates

                                                a.badge.bg-danger.text-decoration-none.fs-6.fw-normal(href="/crm/assets?updates=critical")

                                                    i.bi.bi-shield-exclamation.me-1

                                                    | #{assetSummary.criticalUpdates} mit fehlenden kritischen Updates

                                            if assetSummary.rebootRequired

                                                span.badge.bg-info.text-dark.fs-6.fw-normal

                                                    i.bi.bi-bootstrap-reboot.me-1

                                                    | #{assetSummary.rebootRequired} Neustart erforderlich

                                            if assetSummary.warrantyExpired

                                                span.badge.bg-warning.text-dark.fs-6.fw-normal

                                                    i.bi.bi-calendar-x.me-1

                                                    | #{assetSummary.warrantyExpired} Garantie abgelaufen


                    if show("attention")

                        .col-lg-5

                            .card.shadow-sm.h-100

                                .card-header.d-flex.justify-content-between.align-items-center

                                    h5.mb-0

                                        i.bi.bi-shield-exclamation.me-2

                                        | Handlungsbedarf

                                    if attentionAssets.length

                                        a.btn.btn-sm.btn-outline-danger(href="/crm/assets?updates=critical") Alle

                                .card-body.p-0

                                    if attentionAssets.length

                                        ul.list-group.list-group-flush

                                            each asset in attentionAssets

                                                li.list-group-item.d-flex.justify-content-between.align-items-center

                                                    div

                                                        +onlineDot(asset)

                                                        a.ms-2.text-decoration-none(href=`/crm/assets/${asset._id}`)= asset.name

                                                        if asset.company

                                                            br

                                                            small.text-muted.ms-4= asset.company.companyName

                                                    span.badge.bg-danger(title="Fehlende kritische Updates")

                                                        | #{asset.action1.missingCriticalUpdates} kritisch

                                    else

                                        .p-4.text-center.text-muted

                                            i.bi.bi-shield-check.fs-2.d-block.mb-2.text-success

                                            | Keine Geräte mit fehlenden kritischen Updates.


            if show("action1")

                .row.g-3.mb-4


                    .col-lg-6

                        .card.shadow-sm.h-100

                            .card-header.d-flex.justify-content-between.align-items-center

                                h5.mb-0

                                    i.bi.bi-arrow-repeat.me-2

                                    | Action1-Geräte

                                if currentUser && currentUser.role === "admin"

                                    a.btn.btn-sm.btn-outline-secondary(href="/crm/integrations/action1") Zuordnung

                            .card-body

                                if coverage

                                    .d-flex.align-items-baseline.mb-1

                                        span.display-5.fw-semibold.me-2= coverage.assigned

                                        span.text-muted von #{coverage.total} einer Firma zugeordnet

                                    .progress.mb-2(
                                        role="progressbar"
                                        aria-label="Anteil zugeordneter Action1-Geräte"
                                        aria-valuenow=coverage.percent
                                        aria-valuemin="0"
                                        aria-valuemax="100"
                                        style="height: 10px;"
                                    )

                                        .progress-bar(
                                            class=coverage.unassigned ? "bg-warning" : "bg-success"
                                            style=`width: ${coverage.percent}%`
                                        )

                                    if coverage.unassigned

                                        p.small.mb-2

                                            strong= coverage.unassigned

                                            |  #{coverage.unassigned === 1 ? "Gerät liegt" : "Geräte liegen"} in Organisationen ohne Firma:

                                        ul.list-unstyled.small.mb-2

                                            each org in coverage.unmappedOrgs.slice(0, 5)

                                                li.d-flex.justify-content-between.border-bottom.py-1

                                                    span= org.name

                                                    span.text-muted #{org.endpoints} #{org.endpoints === 1 ? "Gerät" : "Geräte"}

                                    else

                                        p.small.text-success.mb-2

                                            i.bi.bi-check-circle.me-1

                                            | Alle Geräte sind einer Firma zugeordnet.

                                    small.text-muted Stand: letzter Sync #{labels.timeAgo(coverage.at)}

                                else if lastRun

                                    p.text-muted.mb-0

                                        | Beim letzten Sync konnten nicht alle Organisationen gezählt werden.
                                        | Details auf der Action1-Seite.

                                else

                                    p.text-muted.mb-0

                                        | Noch kein Sync gelaufen. Nach der ersten Synchronisation sehen Sie hier,
                                        | wie viele Action1-Geräte einer Firma zugeordnet sind.


        //- =================================================
        //- Vertrieb
        //- =================================================

        if section.key === "vertrieb"

            if show("salesKpis")

                .row.g-3.mb-4

                    .col-xl-3.col-md-6
                        +kpi("Offene Chancen", salesKpis.open, "bi-briefcase", "/crm/sales", "primary")

                    .col-xl-3.col-md-6
                        +kpi("Pipeline / Monat", euro(salesKpis.mrr), "bi-graph-up", "/crm/sales", "info")

                    .col-xl-3.col-md-6
                        +kpi("Prognose / Monat", euro(salesKpis.weightedMrr), "bi-bullseye", "/crm/sales", "success")

                    .col-xl-3.col-md-6
                        +kpi(`Kündigungsfristen (${salesKpis.warningDays} Tage)`, salesKpis.noticeDue, "bi-alarm", "/crm/contracts?due=notice", salesKpis.noticeDue ? "danger" : "success")

            if show("salesTodo") || show("contractsDue")

                .row.g-3.mb-4

                    if show("salesTodo")

                        .col-lg-7

                            .card.shadow-sm.h-100

                                .card-header.d-flex.justify-content-between.align-items-center

                                    h5.mb-0

                                        i.bi.bi-list-check.me-2

                                        | Heute zu tun

                                    a.btn.btn-sm.btn-outline-primary(href="/crm/sales") Pipeline

                                if salesTodo.length

                                    ul.list-group.list-group-flush

                                        each opp in salesTodo

                                            li.list-group-item.d-flex.justify-content-between.align-items-start.gap-2

                                                div

                                                    a.fw-semibold.text-decoration-none(href=`/crm/sales/${opp._id}`)= opp.title

                                                    if opp.company

                                                        span.text-muted.ms-1 · #{opp.company.companyName}

                                                    br

                                                    small.text-muted

                                                        if opp.nextStep && opp.nextStep.text

                                                            | #{opp.nextStep.text}

                                                        else

                                                            | Kein nächster Schritt geplant

                                                        if opp.owner

                                                            |  · #{opp.owner.firstName} #{opp.owner.lastName}

                                                if opp.stepState === "overdue"
                                                    span.badge.bg-danger.text-nowrap überfällig
                                                else if opp.stepState === "today"
                                                    span.badge.bg-warning.text-dark.text-nowrap heute
                                                else if opp.stepState === "soon"
                                                    span.badge.bg-info.text-dark.text-nowrap bald
                                                else
                                                    span.badge.bg-secondary.text-nowrap ohne Schritt

                                else

                                    .p-4.text-center.text-muted

                                        i.bi.bi-check2-circle.fs-2.d-block.mb-2.text-success

                                        | Nichts Überfälliges – alle Chancen haben einen nächsten Schritt.

                    if show("contractsDue")

                        .col-lg-5

                            .card.shadow-sm.h-100

                                .card-header.d-flex.justify-content-between.align-items-center

                                    h5.mb-0

                                        i.bi.bi-alarm.me-2

                                        | Kündigungsfristen

                                    a.btn.btn-sm.btn-outline-primary(href="/crm/contracts?due=notice") Alle

                                if contractsDue.length

                                    ul.list-group.list-group-flush

                                        each contract in contractsDue

                                            li.list-group-item.d-flex.justify-content-between.align-items-start.gap-2

                                                div

                                                    a.text-decoration-none(href=`/crm/contracts/${contract._id}`)= contract.title

                                                    if contract.company

                                                        br

                                                        small.text-muted= contract.company.companyName

                                                span.text-nowrap.small

                                                    +noticeDate(contract)

                                else

                                    .p-4.text-center.text-muted

                                        i.bi.bi-calendar-check.fs-2.d-block.mb-2.text-success

                                        | Keine Kündigungsfrist in den nächsten #{contractWarningDays} Tagen.

            if show("recentCompanies") || show("recentContacts")

                .row.g-3.mb-4

                    if show("recentCompanies")

                        .col-lg-6

                            .card.shadow-sm.h-100

                                .card-header

                                    h5.mb-0 Letzte Firmen

                                .card-body.p-0

                                    if recentCompanies.length

                                        .table-responsive

                                            table.table.table-hover.mb-0

                                                thead.table-light

                                                    tr
                                                        th Kundennr.
                                                        th Firma
                                                        th Status

                                                tbody

                                                    each company in recentCompanies

                                                        tr

                                                            td= company.customerNumber

                                                            td

                                                                a.text-decoration-none(href=`/crm/companies/${company._id}`)= company.companyName

                                                            td

                                                                case company.status
                                                                    when "prospect"
                                                                        span.badge.bg-warning.text-dark Interessent
                                                                    when "active"
                                                                        span.badge.bg-success Aktiv
                                                                    when "inactive"
                                                                        span.badge.bg-secondary Inaktiv
                                                                    default
                                                                        span.badge.bg-light.text-dark -

                                    else

                                        .p-3.text-muted Noch keine Firmen vorhanden.


                    if show("recentContacts")

                        .col-lg-6

                            .card.shadow-sm.h-100

                                .card-header

                                    h5.mb-0 Letzte Kontakte

                                .card-body.p-0

                                    if recentContacts.length

                                        .table-responsive

                                            table.table.table-hover.mb-0

                                                thead.table-light

                                                    tr
                                                        th Name
                                                        th Firma

                                                tbody

                                                    each contact in recentContacts

                                                        tr

                                                            td

                                                                a.text-decoration-none(href=`/crm/contacts/${contact._id}`)
                                                                    | #{contact.firstName} #{contact.lastName}

                                                            td

                                                                if contact.company

                                                                    = contact.company.companyName

                                                                else

                                                                    | -

                                    else

                                        .p-3.text-muted Noch keine Kontakte vorhanden.

        //- =================================================
        //- Verwaltung (Admin)
        //- =================================================

        if section.key === "verwaltung"

            if show("overviewKpis")

                .row.g-3.mb-4

                    .col-xl-3.col-md-6
                        +kpi("Firmen", overviewKpis.companyCount, "bi-buildings", "/crm/companies", "primary")

                    .col-xl-3.col-md-6
                        +kpi("Kontakte", overviewKpis.contactCount, "bi-people", "/crm/contacts", "info")

                    .col-xl-3.col-md-6
                        +kpi("Offene Tickets", overviewKpis.openTicketCount, "bi-ticket-detailed", "/crm/tickets?status=open", overviewKpis.openTicketCount ? "danger" : "success")

                    .col-xl-3.col-md-6
                        +kpi("In Bearbeitung", overviewKpis.inProgressTicketCount, "bi-hourglass-split", "/crm/tickets?status=in_progress", "warning")

            if show("adminHealth") || show("recentTickets")

                .row.g-3.mb-4

                    if show("adminHealth")

                        .col-lg-5

                            .card.shadow-sm.h-100

                                .card-header

                                    h5.mb-0

                                        i.bi.bi-heart-pulse.me-2

                                        | Betrieb

                                .card-body

                                    .row.g-2

                                        .col-6
                                            +stat("NPS (90 Tage)", adminHealth.nps === null ? "—" : (adminHealth.nps > 0 ? "+" + adminHealth.nps : String(adminHealth.nps)), "/crm/surveys?period=90")

                                        .col-6
                                            +stat("Umfrage-Antworten", adminHealth.answers, "/crm/surveys?period=90")

                                        .col-6
                                            +stat("Fehlgeschlagene Mails (7 Tage)", adminHealth.failedMails, "/crm/email-log?status=failed", adminHealth.failedMails ? "danger" : null)

                                        .col-6
                                            +stat("Aktive Benutzer", adminHealth.userCount, "/crm/users")

                    if show("recentTickets")

                        .col-lg-7

                            .card.shadow-sm.h-100

                                .card-header.d-flex.justify-content-between.align-items-center

                                    h5.mb-0

                                        i.bi.bi-ticket-detailed.me-2

                                        | Letzte Tickets

                                    a.btn.btn-sm.btn-outline-primary(href="/crm/tickets") Alle Tickets

                                .card-body.p-0

                                    if recentTickets.length

                                        .table-responsive

                                            table.table.table-hover.align-middle.mb-0

                                                thead.table-light

                                                    tr
                                                        th Ticket
                                                        th Betreff
                                                        th Firma
                                                        th Status

                                                tbody

                                                    each ticket in recentTickets

                                                        tr

                                                            td.text-nowrap

                                                                if can("tickets.view")

                                                                    a.text-decoration-none(href=`/crm/tickets/${ticket._id}`)= ticket.ticketNumber

                                                                else

                                                                    = ticket.ticketNumber

                                                            td

                                                                = ticket.subject

                                                                if ticket.assignedTo

                                                                    br

                                                                    small.text-muted #{ticket.assignedTo.firstName} #{ticket.assignedTo.lastName}

                                                            td

                                                                if ticket.company

                                                                    = ticket.company.companyName

                                                                else

                                                                    | -

                                                            td

                                                                if ticket.status === "open"
                                                                    span.badge.bg-primary Offen
                                                                else if ticket.status === "in_progress"
                                                                    span.badge.bg-warning.text-dark In Bearbeitung
                                                                else if ticket.status === "waiting"
                                                                    span.badge.bg-secondary Wartend
                                                                else if ticket.status === "resolved"
                                                                    span.badge.bg-success Gelöst
                                                                else
                                                                    span.badge.bg-dark Geschlossen

                                    else

                                        .p-3.text-muted Noch keine Tickets vorhanden.
