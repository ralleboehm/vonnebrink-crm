extends ../layouts/main

block content

    .d-flex.justify-content-between.align-items-center.mb-4

        h1.mb-0 #{contact.firstName} #{contact.lastName}

        div

            a.btn.btn-outline-secondary.me-2(
                href=`/crm/contacts/${contact._id}/edit`
            )

                i.bi.bi-pencil.me-2

                | Bearbeiten

            a.btn.btn-secondary(
                href=`/crm/companies/${contact.company._id}`
            )

                i.bi.bi-arrow-left.me-2

                | Zurück zur Firma

    if generatedPassword

        .alert.alert-success

            h5.mb-2

                i.bi.bi-key.me-2

                | Vorläufiges Portal-Passwort

            p.mb-2
                | Gilt nur für die erste Anmeldung. Wurde es nicht per E-Mail verschickt, bitte sicher an den Kunden weitergeben.

            code.fs-5= generatedPassword

    if flash

        .alert(class=`alert-${flash.type}`)= flash.text

    .card.shadow-sm

        .card-header

            h5.mb-0 Kontaktdaten

        .card-body

            .row

                .col-md-6

                    p
                        strong Kontaktnummer:
                        br
                        = contact.contactNumber

                    p
                        strong Firma:
                        br
                        a(href=`/crm/companies/${contact.company._id}`)
                            = contact.company.companyName

                    p
                        strong Anrede:
                        br
                        case contact.salutation
                            when "mr"
                                | Herr
                            when "mrs"
                                | Frau
                            when "diverse"
                                | Divers
                            default
                                | -

                    p
                        strong Position:
                        br
                        = contact.position || "-"

                .col-md-6

                    p
                        strong Telefon:
                        br
                        = contact.phone || "-"

                    p
                        strong Mobil:
                        br
                        = contact.mobile || "-"

                    p
                        strong E-Mail:
                        br
                        = contact.email || "-"

                    p
                        strong Status:
                        br
                        case contact.status
                            when "active"
                                span.badge.bg-success Aktiv
                            when "inactive"
                                span.badge.bg-secondary Inaktiv
                            default
                                span.badge.bg-light.text-dark Unbekannt

            hr

            h5.mb-3

                i.bi.bi-person-lock.me-2

                | Kundenportal

            if portalAccount

                .row

                    .col-md-6

                        p

                            strong Portalzugang:
                            br

                            if portalAccount.active

                                span.badge.bg-success Aktiv

                            else

                                span.badge.bg-secondary Deaktiviert

                        p

                            strong Passwortstatus:
                            br

                            if portalAccount.mustChangePassword

                                span.badge.bg-warning.text-dark
                                    | Passwortwechsel erforderlich

                            else

                                span.badge.bg-success
                                    | Passwort geändert

                    .col-md-6

                        p

                            strong Letzte Anmeldung:
                            br

                            if portalAccount.lastLogin

                                = portalAccount.lastLogin.toLocaleString("de-DE")

                            else

                                span.text-muted Noch keine Anmeldung

                .mt-3.d-flex.gap-2

                    form.d-flex.align-items-center.gap-2(
                        method="POST"
                        action=`/crm/contacts/${contact._id}/portal/reset-password`
                    )

                        button.btn.btn-warning(type="submit")

                            i.bi.bi-key.me-2

                            | Passwort zurücksetzen

                        .form-check.mb-0.small

                            input.form-check-input#resetSendEmail(type="checkbox" name="sendEmail" checked=Boolean(contact.email))

                            label.form-check-label(for="resetSendEmail") per E-Mail schicken

                    if portalAccount.active

                        form(
                            method="POST"
                            action=`/crm/contacts/${contact._id}/portal/deactivate`
                        )

                            button.btn.btn-outline-danger(type="submit")

                                i.bi.bi-person-x.me-2

                                | Portalzugang deaktivieren

                    else

                        form(
                            method="POST"
                            action=`/crm/contacts/${contact._id}/portal/activate`
                        )

                            button.btn.btn-outline-success(type="submit")

                                i.bi.bi-person-check.me-2

                                | Portalzugang aktivieren

            else

                .alert.alert-secondary

                    p.mb-3

                        | Für diesen Ansprechpartner existiert noch kein Portalzugang.

                    form(
                        method="POST"
                        action=`/crm/contacts/${contact._id}/portal/create`
                    )

                        .form-check.mb-3

                            input.form-check-input#welcomeSendEmail(type="checkbox" name="sendEmail" checked=Boolean(contact.email))

                            label.form-check-label(for="welcomeSendEmail") Zugangsdaten per Willkommens-E-Mail an #{contact.email || "den Kontakt"} schicken

                        button.btn.btn-primary(type="submit")

                            i.bi.bi-person-plus.me-2

                            | Portalzugang erstellen

            // =================================================
            // Marketing-Einwilligung
            // =================================================

            hr

            h5.mb-3

                i.bi.bi-envelope-paper.me-2

                | Marketing

            - const consent = marketing.consent

            .row.mb-2

                .col-md-6

                    p

                        strong Einwilligung:

                        br

                        if consent.status === "granted"

                            span.badge.bg-success= marketing.statusLabels.granted

                        else if consent.status === "revoked"

                            span.badge.bg-danger= marketing.statusLabels.revoked

                        else

                            span.badge.bg-secondary= marketing.statusLabels.none

                        if consent.changedAt

                            small.text-muted.ms-2

                                | #{format.formatDateTime(consent.changedAt)}, #{marketing.sourceLabels[consent.source] || ""}

                .col-md-6

                    p

                        strong Für Kampagnen erreichbar:

                        br

                        if !marketing.reason

                            span.badge.bg-success

                                i.bi.bi-check-lg.me-1

                                | Ja

                        else

                            span.badge.bg-light.text-dark.border

                                | Nein – #{marketing.reason}

            if marketing.unsubscribeUrl && consent.status === "granted"

                p.small.mb-2

                    span.text-muted Persönlicher Abmeldelink (für Serienmails):

                    br

                    code.user-select-all= marketing.unsubscribeUrl

            if marketing.doiPending

                p.small.text-muted.mb-2

                    i.bi.bi-hourglass-split.me-1

                    | Bestätigungs-E-Mail verschickt am #{format.formatDateTime(marketing.doiPending.requestedAt)}
                    if marketing.doiPending.requestedBy
                        |  von #{marketing.doiPending.requestedBy}
                    |  – noch nicht bestätigt.

            if can("marketing.manage")

                if consent.status === "granted"

                    form.d-flex.gap-2.align-items-start.mb-3(method="POST" action=`/crm/contacts/${contact._id}/marketing`)

                        input(type="hidden" name="consent" value="revoked")

                        input.form-control.form-control-sm(type="text" name="note" maxlength="500" placeholder="Grund (optional), z. B. telefonisch abgemeldet")

                        button.btn.btn-sm.btn-outline-danger.text-nowrap(type="submit")

                            i.bi.bi-envelope-x.me-1

                            | Widerrufen

                else

                    if marketing.staffMayGrant

                        form.row.g-2.align-items-start.mb-2(method="POST" action=`/crm/contacts/${contact._id}/marketing`)

                            input(type="hidden" name="consent" value="granted")

                            .col-md-4

                                select.form-select.form-select-sm(name="source" aria-label="Art der Einwilligung")

                                    option(value="crm") Einwilligung mit Nachweis

                                    option(value="customer" disabled=!marketing.companyActive) Bestandskunde (§ 7 Abs. 3 UWG)#{marketing.companyActive ? "" : " – nur aktive Kunden"}

                            .col-md-6

                                input.form-control.form-control-sm(type="text" name="note" maxlength="500" required minlength="3" placeholder="Nachweis, z. B. „schriftlich am 09.10.2026“ oder „Hinweis im Vertrag vom …“")

                            .col-md-2

                                button.btn.btn-sm.btn-outline-success.w-100(type="submit")

                                    i.bi.bi-envelope-check.me-1

                                    | Erfassen

                    else

                        p.small.text-muted.mb-2

                            i.bi.bi-lock.me-1

                            | Der Kontakt hat sich selbst abgemeldet (#{marketing.sourceLabels[consent.source]}). Nur er selbst kann sich wieder anmelden – im Kundenportal oder über eine Bestätigungs-E-Mail, die Sie auf seinen Wunsch schicken.

                    form.mb-3(method="POST" action=`/crm/contacts/${contact._id}/marketing/double-opt-in`)

                        button.btn.btn-sm.btn-outline-primary(type="submit" disabled=!contact.email)

                            i.bi.bi-send.me-1

                            | Bestätigungs-E-Mail senden (Double-Opt-In)

                        .form-text Nur auf Wunsch des Kontakts, z. B. Haken „Informationen per E-Mail“ im Kontaktformular der Website.

            if consent.history.length

                details.mb-3

                    summary.small.text-muted Verlauf (#{consent.history.length})

                    ul.list-unstyled.small.mt-2.mb-0

                        each entry in consent.history.slice().reverse()

                            li.border-bottom.py-1

                                strong= entry.status === "granted" ? "Eingewilligt" : "Abgemeldet"

                                |  · #{format.formatDateTime(entry.at)} · #{marketing.sourceLabels[entry.source] || entry.source}

                                if entry.by

                                    |  · #{entry.by}

                                if entry.note

                                    br

                                    span.text-muted= entry.note

            if contact.notes

                hr

                h5 Notizen

                p= contact.notes

    hr

    .d-flex.justify-content-between

        a.btn.btn-secondary(
            href=`/crm/companies/${contact.company._id}`
        )

            i.bi.bi-arrow-left.me-2

            | Zurück zur Firma

        form(
            method="POST"
            action=`/crm/contacts/${contact._id}/delete`
            onsubmit="return confirm('Möchtest du diesen Kontakt wirklich archivieren?');"
        )

            button.btn.btn-danger(type="submit")

                i.bi.bi-archive.me-2

                | Kontakt archivieren