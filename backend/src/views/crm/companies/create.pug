extends ../layouts/main

include _tags

block content

    h1.mb-4 Neue Firma

    form(method="POST" action="/crm/companies")

        .mb-3
            label.form-label(for="companyName") Firmenname
            input.form-control(
                type="text"
                id="companyName"
                name="companyName"
                required
            )

        .mb-3
            label.form-label(for="status") Status
            select.form-select(
                id="status"
                name="status"
            )
                option(value="prospect" selected) Interessent
                option(value="active") Aktiv
                option(value="inactive") Inaktiv

        .mb-3
            label.form-label(for="phone") Telefon
            input.form-control(
                type="text"
                id="phone"
                name="phone"
            )

        .mb-3
            label.form-label(for="email") E-Mail
            input.form-control(
                type="email"
                id="email"
                name="email"
            )

        .mb-3
            label.form-label(for="website") Webseite
            input.form-control(
                type="url"
                id="website"
                name="website"
            )

        +tagInput(null, tagSuggestions)

        hr

        h4 Adresse

        .mb-3
            label.form-label(for="street") Straße
            input.form-control(
                type="text"
                id="street"
                name="street"
            )

        .row

            .col-md-3.mb-3
                label.form-label(for="postalCode") PLZ
                input.form-control(
                    type="text"
                    id="postalCode"
                    name="postalCode"
                )

            .col-md-5.mb-3
                label.form-label(for="city") Ort
                input.form-control(
                    type="text"
                    id="city"
                    name="city"
                )

            .col-md-4.mb-3
                label.form-label(for="country") Land
                input.form-control(
                    type="text"
                    id="country"
                    name="country"
                    value="Deutschland"
                )

        .mt-4

            button.btn.btn-primary(type="submit")
                | 💾 Firma anlegen

            a.btn.btn-secondary.ms-2(href="/crm/companies")
                | Abbrechen