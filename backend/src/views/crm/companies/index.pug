extends ../layouts/main

block content

    .d-flex.justify-content-between.align-items-center.mb-4

        h1.mb-0 Firmen

        a.btn.btn-primary(href="/crm/companies/new")
            | ➕ Neue Firma

    if companies.length

        .card.shadow-sm

            .card-body.p-0

                table.table.table-hover.table-striped.mb-0

                    thead.table-dark

                        tr
                            th Kundennummer
                            th Firma
                            th Status
                            th Telefon
                            th E-Mail
                            th.text-end Aktionen

                    tbody

                        each company in companies

                            tr

                                td
                                    if company.customerNumber
                                        = company.customerNumber
                                    else
                                        | -

                                td
                                    a.text-decoration-none(href=`/crm/companies/${company._id}`)
                                        strong= company.companyName

                                td
                                    case company.status
                                        when "prospect"
                                            span.badge.bg-warning.text-dark Interessent
                                        when "active"
                                            span.badge.bg-success Aktiv
                                        when "inactive"
                                            span.badge.bg-secondary Inaktiv
                                        default
                                            span.badge.bg-light.text-dark Unbekannt

                                td= company.phone

                                td= company.email

                                td.text-end

                                    a.btn.btn-sm.btn-outline-primary.me-1(
                                        href=`/crm/companies/${company._id}`
                                    ) Anzeigen

                                    a.btn.btn-sm.btn-outline-secondary.me-1(
                                        href=`/crm/companies/${company._id}/edit`
                                    ) Bearbeiten

                                    form(
                                        action=`/crm/companies/${company._id}/delete`
                                        method="POST"
                                        style="display:inline;"
                                        onsubmit="return confirm('Firma wirklich löschen?');"
                                    )

                                        button.btn.btn-sm.btn-outline-danger(type="submit")
                                            | Löschen

    else

        .alert.alert-info

            | Es sind noch keine Firmen vorhanden.