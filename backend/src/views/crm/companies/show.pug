extends ../layouts/main

include ../assets/_mixins
include _tags
include _tabs
include ../contracts/_mixins

block content

    .d-flex.justify-content-between.align-items-center.mb-3

        h1.mb-0= company.companyName

        div

            a.btn.btn-outline-secondary.me-2(
                href=`/crm/companies/${company._id}/edit`
            )

                i.bi.bi-pencil.me-2

                | Bearbeiten

            a.btn.btn-secondary(
                href="/crm/companies"
            )

                i.bi.bi-arrow-left.me-2

                | Zurück

    +companyTabs(company, "overview")

    // =====================================================
    // Firmendaten
    // =====================================================

    .card.shadow-sm.mb-4

        .card-header

            h5.mb-0

                i.bi.bi-building.me-2

                | Firmendaten

        .card-body

            .row

                .col-md-6

                    p

                        strong Kundennummer:

                        br

                        = company.customerNumber

                    p

                        strong Status:

                        br

                        case company.status

                            when "prospect"

                                span.badge.bg-warning.text-dark Interessent

                            when "active"

                                span.badge.bg-success Aktiv

                            when "inactive"

                                span.badge.bg-secondary Inaktiv

                            default

                                span.badge.bg-light.text-dark Unbekannt

                    p

                        strong Telefon:

                        br

                        = company.phone || "-"

                    p

                        strong E-Mail:

                        br

                        = company.email || "-"

                    p

                        strong Webseite:

                        br

                        if company.website

                            a(href=company.website target="_blank")

                                = company.website

                        else

                            | -

                .col-md-6

                    p

                        strong Adresse:

                        br

                        if company.address

                            if company.address.street

                                | #{company.address.street}

                                br

                            if company.address.postalCode || company.address.city

                                | #{company.address.postalCode} #{company.address.city}

                                br

                            if company.address.country

                                | #{company.address.country}

                        else

                            | -

                    p

                        strong Branche / Gruppen:

                        br

                        if company.tags && company.tags.length

                            +tagBadges(company.tags, true)

                        else

                            span.text-muted -

                    p

                        strong Action1:

                        br

                        if company.action1 && company.action1.organizationId

                            i.bi.bi-link-45deg.me-1

                            = company.action1.organizationName || company.action1.organizationId

                        else

                            span.text-muted Nicht verknüpft

    // =====================================================
    // Ansprechpartner
    // =====================================================

    .d-flex.justify-content-between.align-items-center.mb-3

        h3.mb-0

            i.bi.bi-people.me-2

            | Ansprechpartner

        a.btn.btn-primary(
            href=`/crm/contacts/new?company=${company._id}`
        )

            i.bi.bi-plus-circle.me-2

            | Neuer Ansprechpartner

    if contacts.length

        .card.shadow-sm.mb-4

            .card-body.p-0

                table.table.table-hover.mb-0

                    thead.table-dark

                        tr

                            th Kontaktnummer
                            th Name
                            th Position
                            th Telefon
                            th E-Mail
                            th.text-end Aktionen

                    tbody

                        each contact in contacts

                            tr

                                td= contact.contactNumber

                                td

                                    a.text-decoration-none(
                                        href=`/crm/contacts/${contact._id}`
                                    )

                                        strong
                                            | #{contact.firstName} #{contact.lastName}

                                td= contact.position

                                td= contact.phone

                                td= contact.email

                                td.text-end

                                    a.btn.btn-sm.btn-outline-primary.me-1(
                                        href=`/crm/contacts/${contact._id}`
                                    )

                                        i.bi.bi-eye.me-1

                                        | Anzeigen

                                    a.btn.btn-sm.btn-outline-secondary(
                                        href=`/crm/contacts/${contact._id}/edit`
                                    )

                                        i.bi.bi-pencil.me-1

                                        | Bearbeiten

    else

        .alert.alert-info

            i.bi.bi-info-circle.me-2

            | Für diese Firma sind noch keine Ansprechpartner vorhanden.

    //- =====================================================
    //- Vertrieb (nur Admin und Vertrieb)
    //- =====================================================

    if opportunities

        .card.shadow-sm.mb-4

            .card-header.d-flex.justify-content-between.align-items-center.flex-wrap.gap-2

                h5.mb-0

                    i.bi.bi-briefcase.me-2

                    | Verkaufschancen

                if can("sales.edit")

                    a.btn.btn-sm.btn-primary(href=`/crm/sales/new?company=${company._id}`)

                        i.bi.bi-plus-circle.me-2

                        | Neue Verkaufschance

            if opportunities.length

                .table-responsive

                    table.table.table-hover.align-middle.mb-0

                        thead.table-light

                            tr
                                th Chance
                                th Phase
                                th.text-end Monatlich
                                th Nächster Schritt

                        tbody

                            each item in opportunities

                                - const due = item.nextStep && item.nextStep.dueDate

                                tr

                                    td

                                        a.fw-semibold.text-decoration-none(href=`/crm/sales/${item._id}`)= item.title

                                        .small.text-muted= item.opportunityNumber

                                    td

                                        span.badge.text-bg-light.border= salesStageLabels[item.stage] || item.stage

                                    td.text-end.text-nowrap= salesEuro(item.mrr)

                                    td.small

                                        if item.nextStep && item.nextStep.text

                                            = item.nextStep.text

                                            if due

                                                span.text-muted  · #{new Date(due).toLocaleDateString("de-DE", { timeZone: "Europe/Berlin" })}

                                        else

                                            span.text-muted —

            else

                .card-body.text-muted.small

                    | Noch keine Verkaufschancen für diese Firma.

    //- =====================================================
    //- Verträge
    //- =====================================================

    if contracts

        .card.shadow-sm.mb-4#contracts

            .card-header.d-flex.justify-content-between.align-items-center

                h5.mb-0

                    i.bi.bi-file-earmark-text.me-2

                    | Verträge

                if can("contracts.edit")

                    a.btn.btn-sm.btn-primary(href=`/crm/contracts/new?company=${company._id}`)

                        i.bi.bi-plus-circle.me-2

                        | Neuer Vertrag

            if contracts.length

                .table-responsive

                    table.table.table-hover.align-middle.mb-0

                        thead.table-light

                            tr
                                th Vertrag
                                th Status
                                th Läuft bis
                                th Kündigung bis

                        tbody

                            each contract in contracts

                                tr

                                    td

                                        a.text-decoration-none(href=`/crm/contracts/${contract._id}`)

                                            strong= contract.title

                                        .small.text-muted= contract.contractNumber

                                    td

                                        +contractStatusBadge(contract.status)

                                    td.text-nowrap

                                        +periodEnd(contract)

                                    td.text-nowrap

                                        +noticeDate(contract)

            else

                .card-body.text-muted.small Noch keine Verträge mit dieser Firma.

    // =====================================================
    // Assets
    // =====================================================

    .card.shadow-sm.mb-4

        .card-header.d-flex.justify-content-between.align-items-center.flex-wrap.gap-2

            div

                h5.mb-0

                    i.bi.bi-pc-display.me-2

                    | Assets

                small.text-muted

                    | #{assetSummary.active} in Betrieb · #{assetSummary.workstations} Arbeitsplätze · #{assetSummary.servers} Server
                    if assetSummary.criticalUpdates

                        |  · 

                        span.text-danger #{assetSummary.criticalUpdates} mit fehlenden kritischen Updates

            div

                a.btn.btn-sm.btn-outline-primary.me-2(href=`/crm/assets?company=${company._id}`)

                    i.bi.bi-list.me-2

                    | Alle anzeigen

                if can("assets.edit")

                    a.btn.btn-sm.btn-primary(href=`/crm/assets/new?company=${company._id}`)

                        i.bi.bi-plus-circle.me-2

                        | Neues Asset

        .card-body.p-0

            if assets.length

                .table-responsive

                    table.table.table-hover.align-middle.mb-0

                        thead.table-light

                            tr

                                th(style="width: 1%")
                                th Gerät
                                th Typ
                                th Betriebssystem
                                th Benutzer
                                th Status
                                th Hinweise

                        tbody

                            each asset in assets

                                tr

                                    td

                                        +onlineDot(asset)

                                    td

                                        a.text-decoration-none(href=`/crm/assets/${asset._id}`)

                                            strong= asset.name

                                        if asset.serialNumber

                                            br

                                            small.text-muted SN #{asset.serialNumber}

                                    td.text-nowrap

                                        +typeLabel(asset.type)

                                    td

                                        small= asset.operatingSystem || "-"

                                    td

                                        if asset.contact

                                            | #{asset.contact.firstName} #{asset.contact.lastName}

                                        else if asset.lastUser

                                            small.text-muted= asset.lastUser

                                        else

                                            | -

                                    td

                                        +statusBadge(asset.status)

                                    td.text-nowrap

                                        +action1Flags(asset)

            else

                .p-4.text-center.text-muted

                    i.bi.bi-pc-display.display-6.d-block.mb-2

                    | Für diese Firma sind noch keine Assets erfasst.

                    if !(company.action1 && company.action1.organizationId)

                        br

                        small Verknüpfen Sie die Firma unter „Action1“ mit einer Organisation, um Geräte automatisch zu übernehmen.

    // =====================================================
    // Letzte Tickets
    // =====================================================

    .card.shadow-sm.mb-4

        .card-header.d-flex.justify-content-between.align-items-center

            h5.mb-0

                i.bi.bi-ticket-detailed.me-2

                | Letzte Tickets

            a.btn.btn-sm.btn-outline-primary(
                href=`/crm/tickets?company=${company._id}`
            )

                i.bi.bi-list.me-2

                | Alle Tickets anzeigen

        .card-body.p-0

            if recentTickets.length

                .table-responsive

                    table.table.table-hover.mb-0

                        thead.table-light

                            tr

                                th Ticket
                                th Betreff
                                th Status
                                th Priorität
                                th Bearbeiter
                                th Erstellt

                        tbody

                            each ticket in recentTickets

                                tr

                                    td

                                        if can("tickets.view")

                                            a.text-decoration-none(
                                                href=`/crm/tickets/${ticket._id}`
                                            )

                                                strong= ticket.ticketNumber

                                        else

                                            strong= ticket.ticketNumber

                                    td= ticket.subject

                                    td

                                        if ticket.status === "open"

                                            span.badge.bg-primary Offen

                                        else if ticket.status === "in_progress"

                                            span.badge.bg-warning.text-dark In Bearbeitung

                                        else if ticket.status === "waiting"

                                            span.badge.bg-secondary Wartend

                                        else if ticket.status === "resolved"

                                            span.badge.bg-success Gelöst

                                        else

                                            span.badge.bg-dark Geschlossen

                                    td

                                        if ticket.priority === "urgent"

                                            span.badge.bg-danger Dringend

                                        else if ticket.priority === "high"

                                            span.badge.bg-warning.text-dark Hoch

                                        else if ticket.priority === "normal"

                                            span.badge.bg-primary Normal

                                        else

                                            span.badge.bg-secondary Niedrig

                                    td

                                        if ticket.assignedTo

                                            | #{ticket.assignedTo.firstName} #{ticket.assignedTo.lastName}

                                        else

                                            span.text-muted Nicht zugewiesen

                                    td

                                        = ticket.createdAt.toLocaleDateString("de-DE")

            else

                .p-5.text-center

                    i.bi.bi-ticket-detailed.display-4.text-muted

                    h5.mt-3 Noch keine Tickets vorhanden

                    p.text-muted

                        | Für diese Firma wurden bisher keine Tickets erstellt.

                    if can("tickets.edit")

                        a.btn.btn-primary(
                            href=`/crm/tickets/new?company=${company._id}`
                        )

                            i.bi.bi-plus-circle.me-2

                            | Neues Ticket erstellen