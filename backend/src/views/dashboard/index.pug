extends ../layouts/main

block content
    h1.mb-4 Dashboard

    .row.g-4.mb-4
        .col-md-3
            .card.shadow-sm
                .card-body.text-center
                    h6.text-muted Firmen
                    h2.display-5.mb-0= companyCount

        .col-md-3
            .card.shadow-sm
                .card-body.text-center
                    h6.text-muted Kontakte
                    h2.display-5.mb-0= contactCount

        .col-md-3
            .card.shadow-sm
                .card-body.text-center
                    h6.text-muted Offene Tickets
                    h2.display-5.mb-0= openTicketCount

        .col-md-3
            .card.shadow-sm
                .card-body.text-center
                    h6.text-muted In Bearbeitung
                    h2.display-5.mb-0= inProgressTicketCount

    .row.g-4
        .col-lg-6
            .card.shadow-sm
                .card-header
                    h5.mb-0 Letzte Firmen

                .card-body.p-0
                    if recentCompanies.length
                        .table-responsive
                            table.table.table-hover.mb-0
                                thead.table-light
                                    tr
                                        th Kundennr.
                                        th Firma
                                        th Status

                                tbody
                                    each company in recentCompanies
                                        tr
                                            td= company.customerNumber
                                            td
                                                a.text-decoration-none(
                                                    href=`/companies/${company._id}`
                                                )
                                                    = company.companyName
                                            td= company.status
                    else
                        .p-3.text-muted
                            | Noch keine Firmen vorhanden.

        .col-lg-6
            .card.shadow-sm
                .card-header
                    h5.mb-0 Letzte Kontakte

                .card-body.p-0
                    if recentContacts.length
                        .table-responsive
                            table.table.table-hover.mb-0
                                thead.table-light
                                    tr
                                        th Name
                                        th Firma

                                tbody
                                    each contact in recentContacts
                                        tr
                                            td
                                                a.text-decoration-none(
                                                    href=`/contacts/${contact._id}`
                                                )
                                                    | #{contact.firstName} #{contact.lastName}
                                            td
                                                if contact.company
                                                    = contact.company.companyName
                                                else
                                                    | -
                    else
                        .p-3.text-muted
                            | Noch keine Kontakte vorhanden.

    .card.shadow-sm.mt-4
        .card-header
            h5.mb-0 Letzte Tickets

        .card-body.p-0
            if recentTickets.length
                .table-responsive
                    table.table.table-hover.mb-0
                        thead.table-light
                            tr
                                th Ticket
                                th Beschreibung
                                th Firma
                                th Status
                                th Bearbeiter

                        tbody
                            each ticket in recentTickets
                                tr
                                    td
                                        a.text-decoration-none(
                                            href=`/tickets/${ticket._id}`
                                        )
                                            = ticket.ticketNumber

                                    td= ticket.description

                                    td
                                        if ticket.company
                                            = ticket.company.companyName
                                        else
                                            | -

                                    td
                                        if ticket.status === "open"
                                            span.badge.bg-primary Offen
                                        else if ticket.status === "in_progress"
                                            span.badge.bg-warning.text-dark In Bearbeitung
                                        else if ticket.status === "waiting"
                                            span.badge.bg-secondary Wartend
                                        else if ticket.status === "resolved"
                                            span.badge.bg-success Gelöst
                                        else
                                            span.badge.bg-dark Geschlossen

                                    td
                                        if ticket.assignedTo
                                            | #{ticket.assignedTo.firstName} #{ticket.assignedTo.lastName}
                                        else
                                            | Nicht zugewiesen
            else
                .p-3.text-muted
                    | Noch keine Tickets vorhanden.