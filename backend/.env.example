PORT=3000

NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/vonnebrinkCRM

# Required in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=CHANGE_ME

# Optional, default is 100
MAX_UPLOAD_SIZE_MB=100

# ----------------------------------------------------
# Action1 (RMM) – optional
# ----------------------------------------------------
# API-Schlüssel in Action1 unter Configuration -> API Credentials anlegen
# (lesender Zugriff auf Organisationen und Endpoints genügt).
ACTION1_CLIENT_ID=
ACTION1_CLIENT_SECRET=

# Adresse, unter der Sie sich bei Action1 anmelden
# (z. B. https://app.action1.com oder die EU-Adresse Ihres Kontos).
# "/api/3.0" wird automatisch ergänzt.
ACTION1_BASE_URL=https://app.action1.com

# Automatischer Sync in Minuten (mindestens 15). Leer = nur manuell.
ACTION1_SYNC_INTERVAL_MINUTES=

# ----------------------------------------------------
# E-Mail (SMTP) – optional
# ----------------------------------------------------
# Ohne SMTP_HOST werden E-Mails nicht verschickt, sondern nur im Log angezeigt.
SMTP_HOST=
# 587 = STARTTLS (Standard), 465 = direkt TLS
SMTP_PORT=587
# Leer lassen: wird aus dem Port abgeleitet (465 -> true)
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Absender, z. B. "Vonnebrink IT Operations <support@vonnebrink.com>"
MAIL_FROM=
# Optional: Antworten an diese Adresse
MAIL_REPLY_TO=
# Optional: Firmenname in E-Mails (Standard: Vonnebrink IT Operations)
MAIL_BRAND_NAME=
# Link zur Webseite im E-Mail-Fuß (Standard: https://vonnebrink.com)
MAIL_BRAND_URL=

# Öffentliche Adresse des CRM für Links in E-Mails (ohne / am Ende),
# z. B. https://crm.ihre-domain.de
APP_URL=

# ----------------------------------------------------
# Dokumente (Nextcloud) – optional
# ----------------------------------------------------
# Ohne diese Werte ist die Dokumentenablage aus; das CRM läuft normal.
# Eigenen Nextcloud-Benutzer für das CRM anlegen und ein App-Passwort
# erzeugen (Einstellungen -> Sicherheit). Danach: npm run nextcloud:setup
NEXTCLOUD_URL=
NEXTCLOUD_USERNAME=
NEXTCLOUD_PASSWORD=
# Hauptordner des CRM in Nextcloud (Standard: CRM)
NEXTCLOUD_ROOT_FOLDER=CRM
# Wartezeit je Anfrage in Millisekunden (Standard: 30000)
NEXTCLOUD_TIMEOUT=30000
