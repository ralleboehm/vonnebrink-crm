{
  "name": "vonnebrink-crm-backend",
  "version": "1.0.0",
  "description": "Self-hosted CRM and Customer Portal for Managed Service Providers",
  "main": "src/server.js",
  "scripts": {
    "start": "mkdir -p logs && node src/server.js 2>&1 | tee -a logs/crm.log",
    "start:plain": "node src/server.js",
    "dev": "mkdir -p logs && nodemon src/server.js 2>&1 | tee -a logs/crm.log",
    "dev:plain": "nodemon src/server.js",
    "test": "node --test test/*.test.js",
    "test:smoke": "SMOKE_TEST=1 node --test --test-concurrency=1 test/smoke.test.js",
    "create-admin": "node src/scripts/create-admin.js",
    "dev:reset-demo-data": "node src/scripts/reset-demo-data.js",
    "dev:seed": "node src/scripts/seed-demo-data.js",
    "dev:reset": "node src/scripts/dev-reset.js",
    "nextcloud:setup": "node src/scripts/nextcloud-setup.js"
  },
  "keywords": [
    "crm",
    "ticketing",
    "helpdesk",
    "customer-portal",
    "msp",
    "nodejs",
    "express",
    "mongodb"
  ],
  "author": "Vonnebrink IT Operations",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.10.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.15",
    "pug": "^3.0.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
