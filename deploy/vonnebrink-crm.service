# systemd-Dienst für das CRM auf der VPS
# Kopieren nach /etc/systemd/system/vonnebrink-crm.service, dann:
#   systemctl daemon-reload && systemctl enable --now vonnebrink-crm

[Unit]
Description=Vonnebrink CRM
After=network-online.target mongod.service
Wants=network-online.target

[Service]
Type=simple
User=crm
Group=crm
WorkingDirectory=/opt/vonnebrink-crm/backend
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production

# Absicherung
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
